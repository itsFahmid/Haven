@model Haven.Models.Article
@{
    ViewData["Title"] = Model.TitleBn;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a asp-action="Index" class="hover:text-teal-700">← নিবন্ধ হাব</a>
        <span>/</span>
        <span class="text-slate-800">@Model.Category</span>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="space-y-3 pb-6 border-b border-slate-100">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-800 border border-teal-200">
                @Model.Category
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
                @Model.TitleBn
            </h1>
            <p class="text-xs text-slate-400">
                প্রকাশের তারিখ: @Model.CreatedAt.ToString("MMMM dd, yyyy") | বিএমডিসি ভেরিফায়েড কন্টেন্ট
            </p>
        </div>

        <div class="prose max-w-none text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <p>@Model.ContentMarkdown</p>
        </div>

        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition">
                ← অন্য সকল নিবন্ধ দেখুন
            </a>
            <button type="button" onclick="showToast('নিবন্ধ বুকমার্ক করা হয়েছে!')" class="px-4 py-2 bg-teal-50 text-teal-800 font-bold text-xs rounded-xl border border-teal-200 transition">
                বুকমার্ক করুন
            </button>
        </div>
    </div>

</div>
