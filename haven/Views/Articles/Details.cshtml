@model Haven.Models.Article
@{
    ViewData["Title"] = Model.TitleBn + " | Article Details";
    var isBookmarked = ViewBag.IsBookmarked == true;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a asp-action="Index" class="hover:text-teal-700 font-bold">← <span data-bn="সকল নিবন্ধ (All Articles)" data-en="Back to Articles">সকল নিবন্ধ</span></a>
        <span>/</span>
        <span class="text-teal-800 font-bold">@Model.Category</span>
        <span>/</span>
        <span class="text-slate-700 truncate max-w-xs">@Model.TitleBn</span>
    </div>

    <!-- Article Main Card -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg space-y-8">
        
        <!-- Header Info -->
        <div class="space-y-4 pb-6 border-b border-slate-100">
            <div class="flex items-center justify-between gap-4">
                <span class="px-3.5 py-1 rounded-full text-xs font-black bg-teal-50 text-teal-800 border border-teal-200 uppercase">
                    @Model.Category
                </span>

                <!-- Bookmark Button -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="ToggleBookmark" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="articleId" value="@Model.Id" />
                        <button type="submit" class="px-4 py-2 rounded-2xl text-xs font-black transition flex items-center gap-1.5 shadow-2xs @(isBookmarked ? "bg-amber-100 text-amber-900 border border-amber-300" : "bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900")">
                            <span>🔖</span>
                            <span>@(isBookmarked ? "বুকমার্ক সংরক্ষিত (Bookmarked)" : "বুকমার্ক করুন (Bookmark)")</span>
                        </button>
                    </form>
                }
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 leading-tight">
                @Model.TitleBn
            </h1>
            <p class="text-sm font-bold text-slate-500">@Model.TitleEn</p>

            <div class="flex items-center gap-4 text-xs font-semibold text-slate-500 pt-2">
                <span>লেখক: <strong class="text-slate-800">@(Model.Author?.FullName ?? "HAVEN Clinical Team")</strong></span>
                <span>•</span>
                <span>📅 প্রকাশিত: @Model.CreatedAt.ToString("dd MMMM, yyyy")</span>
            </div>
        </div>

        <!-- Content Markdown Body -->
        <div class="prose prose-slate max-w-none text-slate-800 leading-relaxed font-sans text-sm sm:text-base whitespace-pre-wrap space-y-4">
            @Model.ContentMarkdown
        </div>

        <!-- Footer Action -->
        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
            <a asp-action="Index" class="px-5 py-2.5 bg-slate-100 text-slate-700 font-bold text-xs rounded-xl hover:bg-slate-200 transition">
                ← সকল নিবন্ধে ফিরে যান
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Bookmarks" class="px-5 py-2.5 bg-amber-50 text-amber-900 border border-amber-200 font-extrabold text-xs rounded-xl hover:bg-amber-100 transition">
                    আমার সব বুকমার্কস দেখুন ➔
                </a>
            }
        </div>

    </div>

</div>
