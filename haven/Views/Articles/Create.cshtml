@model Haven.Models.Article
@{
    ViewData["Title"] = "নতুন নিবন্ধ প্রকাশ করুন | Create Article";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="space-y-2">
        <h1 class="text-2xl font-black text-slate-900">নতুন সাইবার সুরক্ষা ও মনোবিজ্ঞান নিবন্ধ প্রকাশ (FR-9)</h1>
        <p class="text-xs text-slate-500">ভেরিফায়েড বিশেষজ্ঞ ও লেখকদের দ্বারা রচিত পাঠ্যক্রম</p>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-amber-900 bg-amber-50 p-3 rounded-xl"></div>

            <div>
                <label asp-for="TitleBn" class="block text-xs font-bold text-slate-700 uppercase mb-2">নিবন্ধের শিরোনাম (বাংলা)</label>
                <input asp-for="TitleBn" required placeholder="e.g. অনলাইন গ্রুমিং চেনার ১০টি পূর্বলক্ষণ" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
            </div>

            <div>
                <label asp-for="Category" class="block text-xs font-bold text-slate-700 uppercase mb-2">ক্যাটাগরি</label>
                <select asp-for="Category" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm">
                    <option value="Grooming Prevention">গ্রুমিং প্রতিরোধ (Grooming Prevention)</option>
                    <option value="Cyber Harassment">সাইবার ব্ল্যাকমেইল ও বুলিং (Cyber Harassment)</option>
                    <option value="Mental Health">মানসিক স্বাস্থ্য ও প্যানিক (Mental Health)</option>
                </select>
            </div>

            <div>
                <label asp-for="ContentMarkdown" class="block text-xs font-bold text-slate-700 uppercase mb-2">নিবন্ধের বিস্তারিত মূল বিষয়বস্তু</label>
                <textarea asp-for="ContentMarkdown" rows="8" required placeholder="নিবন্ধের বিস্তারিত আলোচনা লিখুন..." class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm"></textarea>
            </div>

            <button type="submit" class="w-full py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl shadow-xs transition">
                নিবন্ধ প্রকাশ করুন
            </button>
        </form>
    </div>
</div>
