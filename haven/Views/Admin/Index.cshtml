@model Obhoy.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "এডমিন ও প্ল্যাটফর্ম সিস্টেম কন্ট্রোল | Admin Operations";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Admin Hero Header -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <span class="px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
                System Administration & Governance
            </span>
            <h1 class="text-2xl sm:text-3xl font-black mt-2 tracking-tight">
                অভয় অ্যাডমিন ও সিকিউরিটি কন্ট্রোল
            </h1>
            <p class="text-xs text-slate-300 mt-1">
                লাইসেন্স ভেরিফিকেশন, থেরাপিস্ট কোর্স অনুমোদন এবং ইউজার সেফটি অডিট ট্রেইল
            </p>
        </div>

        <div class="flex items-center gap-4 text-center">
            <div class="bg-slate-800 px-4 py-2.5 rounded-2xl border border-slate-700">
                <div class="text-lg font-black text-teal-400">@Model.TotalUsersCount</div>
                <div class="text-[10px] text-slate-400">মোট ইউজার</div>
            </div>
            <div class="bg-slate-800 px-4 py-2.5 rounded-2xl border border-slate-700">
                <div class="text-lg font-black text-amber-400">@Model.PendingCourses.Count</div>
                <div class="text-[10px] text-slate-400">পেন্ডিং কোর্স</div>
            </div>
            <div class="bg-slate-800 px-4 py-2.5 rounded-2xl border border-slate-700">
                <div class="text-lg font-black text-sky-400">@Model.PendingTherapists.Count</div>
                <div class="text-[10px] text-slate-400">পেন্ডিং লাইসেন্স</div>
            </div>
            <div class="bg-slate-800 px-4 py-2.5 rounded-2xl border border-slate-700">
                <div class="text-lg font-black text-emerald-400">@Model.PendingHallOfFameDonors.Count</div>
                <div class="text-[10px] text-slate-400">হল অফ ফেম পেন্ডিং</div>
            </div>
        </div>
    </div>

    <!-- Section 1: Pending Course Review & Approval -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900" data-bn="থেরাপিস্ট প্রকাশিত পেন্ডিং কোর্স অনুমোদন" data-en="Pending Course Approvals">
                    থেরাপিস্ট প্রকাশিত পেন্ডিং কোর্স অনুমোদন
                </h3>
                <p class="text-xs text-slate-500">থেরাপিস্টদের প্রস্তুতকৃত কোর্সসমূহ পর্যালোচনা করে পাবলিক ক্যাটালগে অনুমোদনের ব্যবস্থা করুন</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900">
                @Model.PendingCourses.Count Pending Courses
            </span>
        </div>

        @if (!Model.PendingCourses.Any())
        {
            <div class="text-center py-8 text-xs text-slate-500 bg-slate-50 rounded-2xl border border-slate-100">
                কোনো পেন্ডিং কোর্স আবেদন নেই। সকল থেরাপিস্ট কোর্স অনুমোদিত।
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var course in Model.PendingCourses)
                {
                    <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                        <div class="space-y-1 max-w-2xl">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-100 text-teal-800">
                                    🏷️ @course.TargetGen
                                </span>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">
                                    @course.CategoryEn
                                </span>
                            </div>
                            <h4 class="text-sm font-black text-slate-900">@course.TitleBn (@course.TitleEn)</h4>
                            <p class="text-xs text-slate-600 line-clamp-2">@course.DescriptionBn</p>
                            <p class="text-[11px] text-slate-500">
                                লেখক (Author): <strong class="text-slate-800">@(course.Author?.FullName ?? "Therapist")</strong> • ⏱️ @course.DurationEn • @course.Modules.Count মডিউল
                            </p>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <form asp-action="ApproveCourse" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@course.Id" />
                                <button type="submit" class="px-4 py-2 bg-emerald-700 text-white font-bold text-xs rounded-xl hover:bg-emerald-800 transition">
                                    অনুমোদন (Approve) ✓
                                </button>
                            </form>

                            <form asp-action="RejectCourse" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@course.Id" />
                                <button type="submit" class="px-4 py-2 bg-rose-100 text-rose-800 font-bold text-xs rounded-xl hover:bg-rose-200 transition">
                                    বাতিল (Reject) ✕
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Section 2: Pending Therapist License Review -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900" data-bn="লাইসেন্স ভেরিফিকেশন আবেদন" data-en="Pending License Verification Requests">
                    লাইসেন্স ভেরিফিকেশন আবেদন
                </h3>
                <p class="text-xs text-slate-500">বিএমডিসি লাইসেন্স ও আইডি রিভিউ করে ভেরিফায়েড স্ট্যাটাস প্রদান করুন</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900">
                @Model.PendingTherapists.Count Pending
            </span>
        </div>

        @if (!Model.PendingTherapists.Any())
        {
            <div class="text-center py-8 text-xs text-slate-500 bg-slate-50 rounded-2xl border border-slate-100">
                কোনো পেন্ডিং থেরাপিস্ট লাইসেন্স আবেদন নেই।
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var therapist in Model.PendingTherapists)
                {
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-xs font-black text-slate-900">@(therapist.User?.FullName ?? "Unknown")</h4>
                                <span class="px-2 py-0.5 bg-teal-100 text-teal-800 text-[10px] font-bold rounded-md">Reg: @therapist.LicenseNo</span>
                            </div>
                            <p class="text-xs text-slate-700 font-medium">@therapist.TitleEn • @therapist.Specialty • @therapist.YearsOfExperience Years Exp • ৳ @therapist.HourlyRateBDT / hr</p>
                            <p class="text-[11px] text-slate-500 font-mono">🕒 Availability: @(therapist.ConsultationTime ?? "N/A")</p>
                            @if (!string.IsNullOrWhiteSpace(therapist.Bio))
                            {
                                <p class="text-[11px] text-slate-600 italic">"@therapist.Bio"</p>
                            }
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <form asp-action="ApproveTherapist" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@therapist.Id" />
                                <button type="submit" class="px-4 py-2 bg-emerald-700 text-white font-extrabold text-xs rounded-xl hover:bg-emerald-800 transition shadow-xs">
                                    Approve & Upgrade Role
                                </button>
                            </form>
                            <form asp-action="RejectTherapist" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@therapist.Id" />
                                <button type="submit" class="px-3.5 py-2 bg-rose-100 text-rose-800 font-bold text-xs rounded-xl hover:bg-rose-200 transition">
                                    Reject
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Section 3: Reported Content & User Safety Moderation -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900" data-bn="ইউজার রিপোর্টকৃত পোস্ট ও সাইবার মডারেশন" data-en="Reported Content & User Safety Moderation">
                    ইউজার রিপোর্টকৃত পোস্ট ও সাইবার মডারেশন
                </h3>
                <p class="text-xs text-slate-500">কমিউনিটি ইউজারদের জমা দেওয়া পোস্ট রিপোর্ট পর্যালোচনা করে মডারেশন অ্যাকশন নিন</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-900">
                @Model.ReportedPosts.Count Reported Posts
            </span>
        </div>

        @if (!Model.ReportedPosts.Any())
        {
            <div class="text-center py-8 text-xs text-slate-500 bg-slate-50 rounded-2xl border border-slate-100">
                কোনো আপত্তিজনক বা রিপোর্টকৃত পোস্ট পাওয়া যায়নি। কমিউনিটি নিরাপদ ও পরিষ্কার।
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var post in Model.ReportedPosts)
                {
                    <div class="p-5 rounded-2xl bg-rose-50/50 border border-rose-200 space-y-3">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-600 text-white">
                                        🚨 @post.ReportCount Reports
                                    </span>
                                    <span class="text-xs font-bold text-slate-900">@post.Title</span>
                                </div>
                                <p class="text-xs text-slate-600 mt-1 line-clamp-2">@post.Content</p>
                                <div class="text-[11px] text-slate-400 mt-1">
                                    লেখক: <strong>@(post.IsAnonymous ? "Anonymous User" : post.User?.FullName ?? "User")</strong> | তারিখ: @post.CreatedAt.ToString("MMM dd, yyyy - HH:mm")
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <form asp-action="DismissReport" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@post.Id" />
                                    <button type="submit" class="px-3.5 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs rounded-xl transition">
                                        Dismiss Report
                                    </button>
                                </form>
                                <form asp-action="DeletePost" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@post.Id" />
                                    <button type="submit" class="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
                                        Delete Post
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Section 4: Sanctuary Hall of Fame Moderation -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-8">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900" data-bn="হল অফ ফেম অনুদান অনুমোদন ও মডারেশন" data-en="Sanctuary Hall of Fame Moderation">
                    হল অফ ফেম অনুদান অনুমোদন ও মডারেশন
                </h3>
                <p class="text-xs text-slate-500">
                    যেসব দাতা অনুদানের সময় নিজেদের নাম ও শুভেচ্ছা বার্তা হল অফ ফেমে যুক্ত করার আবেদন করেছেন, তাদের যাচাই করে অনুমোদন বা বাতিল করুন।
                </p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold @(Model.PendingHallOfFameDonors.Any() ? "bg-amber-100 text-amber-900" : "bg-slate-100 text-slate-600")">
                @Model.PendingHallOfFameDonors.Count Pending Approvals
            </span>
        </div>

        <!-- Subsection 4A: Pending Approvals -->
        <div class="space-y-4">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h4 class="text-xs font-black uppercase tracking-wider text-slate-700">পেন্ডিং আবেদন সমূহ / Awaiting Review</h4>
            </div>

            @if (!Model.PendingHallOfFameDonors.Any())
            {
                <div class="text-center py-6 text-xs text-slate-500 bg-slate-50 rounded-2xl border border-slate-100">
                    বর্তমানে কোনো পেন্ডিং আবেদন নেই। সকল অনুদানকারী তালিকাভুক্ত বা প্রক্রিয়াজাত।
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var donor in Model.PendingHallOfFameDonors)
                    {
                        <div class="p-5 rounded-2xl bg-amber-50/40 border border-amber-200/80 space-y-3 flex flex-col justify-between">
                            <div class="space-y-2">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-9 h-9 rounded-xl bg-amber-600 text-white font-black text-xs flex items-center justify-center shadow-xs">
                                            @(string.IsNullOrWhiteSpace(donor.DisplayName) ? "G" : donor.DisplayName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <h5 class="text-xs font-black text-slate-900">@(donor.DisplayName ?? "Anonymous Supporter")</h5>
                                            <span class="text-[10px] text-slate-500">@(donor.City ?? "Bangladesh") • @donor.CreatedAt.ToString("MMM dd, yyyy - HH:mm")</span>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-1 bg-amber-100 text-amber-900 text-xs font-black rounded-lg border border-amber-200">
                                        ৳@donor.Amount.ToString("N0")
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(donor.RecognitionMessage))
                                {
                                    <div class="p-3 bg-white/90 rounded-xl border border-amber-100 text-xs text-slate-700 italic">
                                        "@donor.RecognitionMessage"
                                    </div>
                                }

                                <div class="text-[10px] text-slate-500 font-mono">
                                    TranId: @donor.TransactionId • Gateway: @donor.Gateway
                                </div>
                            </div>

                            <div class="flex items-center gap-2 pt-2 border-t border-amber-200/60">
                                <form asp-action="ApproveHallOfFame" method="post" class="flex-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@donor.Id" />
                                    <button type="submit" class="w-full py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center justify-center gap-1.5">
                                        <span>অনুমোদন করুন (Approve)</span> ✓
                                    </button>
                                </form>
                                <form asp-action="RejectHallOfFame" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@donor.Id" />
                                    <button type="submit" class="px-3.5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs rounded-xl transition">
                                        বাতিল (Dismiss)
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Subsection 4B: Active / Approved Guardians -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <h4 class="text-xs font-black uppercase tracking-wider text-slate-700">অনুমোদিত হল অফ ফেম দাতা / Public Guardians (@Model.ApprovedHallOfFameDonors.Count)</h4>
                </div>
                <span class="text-[11px] text-slate-400">সর্বোচ্চ ২৫ জন প্রদর্শিত</span>
            </div>

            @if (!Model.ApprovedHallOfFameDonors.Any())
            {
                <div class="text-center py-6 text-xs text-slate-400 bg-slate-50 rounded-2xl border border-slate-100">
                    এখনও কোনো দাতা পাবলিক হল অফ ফেমে প্রদর্শনের জন্য অনুমোদিত হননি।
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    @foreach (var donor in Model.ApprovedHallOfFameDonors)
                    {
                        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/90 flex flex-col justify-between gap-2">
                            <div>
                                <div class="flex items-center justify-between">
                                    <h5 class="text-xs font-black text-slate-900 truncate">@(donor.DisplayName ?? "Anonymous")</h5>
                                    <span class="text-xs font-black text-teal-800">৳@donor.Amount.ToString("N0")</span>
                                </div>
                                <span class="text-[10px] text-slate-400">@donor.CreatedAt.ToString("MMM dd, yyyy")</span>
                                @if (!string.IsNullOrWhiteSpace(donor.RecognitionMessage))
                                {
                                    <p class="text-[11px] text-slate-600 italic line-clamp-1 mt-1">"@donor.RecognitionMessage"</p>
                                }
                            </div>
                            <form asp-action="RejectHallOfFame" method="post" class="pt-2 border-t border-slate-200/60">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@donor.Id" />
                                <button type="submit" class="w-full py-1 text-[11px] text-rose-700 hover:text-rose-900 hover:bg-rose-50 font-semibold rounded-lg transition">
                                    লুকান / অনুমোদন প্রত্যাহার (Revoke)
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Section 5: Audit Trail Log -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <h3 class="text-base font-bold text-slate-900">অ্যাডমিন ক্রিয়াকলাপ অডিট ট্রেইল (Security Audit Log)</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-slate-200 text-slate-500 font-bold uppercase">
                        <th class="py-2.5">Time</th>
                        <th class="py-2.5">Action</th>
                        <th class="py-2.5">Target</th>
                        <th class="py-2.5">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var log in Model.AuditLogs)
                    {
                        <tr>
                            <td class="py-2.5 text-slate-400">@log.ExecutedAt.ToString("HH:mm:ss dd MMM")</td>
                            <td class="py-2.5 font-bold text-slate-800">@log.ActionType</td>
                            <td class="py-2.5 font-mono text-slate-600">@log.TargetResource</td>
                            <td class="py-2.5 text-slate-600">@log.ActionDetails</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
