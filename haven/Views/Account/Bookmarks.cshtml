@model IEnumerable<Haven.Models.Article>
@{
    ViewData["Title"] = "বুকমার্ক করা নিবন্ধ সমূহ | Bookmarked Articles";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-action="Profile" class="hover:text-teal-700">← প্রোফাইল</a>
                <span>/</span>
                <span class="text-slate-800">বুকমার্কস</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900" data-bn="আপনার সংরক্ষিত ও বুকমার্ক করা নিবন্ধ" data-en="Your Saved & Bookmarked Articles">
                আপনার সংরক্ষিত ও বুকমার্ক করা নিবন্ধ
            </h1>
            <p class="text-xs text-slate-500 mt-1">
                ভবিষ্যতে দ্রুত পড়ার জন্য সংরক্ষিত মানসিক স্বাস্থ্য ও সাইবার সুরক্ষা সহায়িকা
            </p>
        </div>

        <a asp-controller="Articles" asp-action="Index" class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl shadow-xs transition">
            সকল নিবন্ধ দেখুন ➔
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">কোনো বুকমার্ক পাওয়া যায়নি</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto">নিবন্ধ পড়ার সময় 'বুকমার্ক করুন' বাটনে ক্লিক করে এখানে সহজে খুঁজে পাওয়ার জন্য সংরক্ষণ করুন।</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var article in Model)
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200">
                            @article.Category
                        </span>
                        <h3 class="text-base font-bold text-slate-900 leading-snug">
                            @article.TitleBn
                        </h3>
                        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                            @article.ContentMarkdown
                        </p>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[11px] text-slate-400 font-medium">@article.CreatedAt.ToString("MMM dd, yyyy")</span>
                        <a asp-controller="Articles" asp-action="Details" asp-route-id="@article.Id" class="text-xs font-bold text-teal-700 hover:text-teal-800 transition">
                            পড়ুন ➔
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>
