@model IEnumerable<Haven.Models.Article>
@{
    ViewData["Title"] = "বুকমার্ক করা নিবন্ধ সমূহ | Bookmarked Articles";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-action="Profile" class="hover:text-teal-700 font-bold">← প্রোফাইল</a>
                <span>/</span>
                <span class="text-slate-800 font-bold">বুকমার্কস</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900" data-bn="আপনার সংরক্ষিত ও বুকমার্ক করা নিবন্ধ" data-en="Your Saved & Bookmarked Articles">
                আপনার সংরক্ষিত ও বুকমার্ক করা নিবন্ধ
            </h1>
            <p class="text-xs text-slate-500 mt-1">
                ভবিষ্যতে দ্রুত পড়ার জন্য সংরক্ষিত মানসিক স্বাস্থ্য ও সাইবার সুরক্ষা সহায়িকা নিবন্ধ
            </p>
        </div>

        <a asp-controller="Articles" asp-action="Index" class="px-4 py-2.5 bg-teal-800 hover:bg-teal-900 text-white font-bold text-xs rounded-xl shadow-xs transition">
            সকল নিবন্ধ দেখুন ➔
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 space-y-4 max-w-lg mx-auto">
            <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto text-2xl font-bold">
                🔖
            </div>
            <h3 class="text-base font-black text-slate-900">কোনো বুকমার্ক করা নিবন্ধ পাওয়া যায়নি</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
                নিবন্ধ পড়ার সময় <strong>'বুকমার্ক করুন'</strong> বাটনে ক্লিক করে পরবর্তীতে সহজে পড়ার জন্য এখানে সংরক্ষণ করুন।
            </p>
            <a asp-controller="Articles" asp-action="Index" class="inline-block px-5 py-2.5 bg-teal-800 text-white text-xs font-extrabold rounded-xl hover:bg-teal-900 transition">
                নিবন্ধ হাব ব্রাউজ করুন ➔
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var article in Model)
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4 relative group">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between gap-2">
                            <span class="px-3 py-1 rounded-full text-[10px] font-black bg-teal-50 text-teal-800 border border-teal-200 uppercase">
                                @article.Category
                            </span>

                            <!-- Remove Bookmark Form -->
                            <form asp-controller="Articles" asp-action="ToggleBookmark" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="articleId" value="@article.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold text-xs p-1" title="Remove Bookmark">
                                    ✕ মুছে ফেলুন
                                </button>
                            </form>
                        </div>

                        <a asp-controller="Articles" asp-action="Details" asp-route-id="@article.Id" class="block space-y-1">
                            <h3 class="text-base font-black text-slate-900 group-hover:text-teal-700 transition leading-snug">
                                @article.TitleBn
                            </h3>
                            <p class="text-xs text-slate-500 font-semibold">@article.TitleEn</p>
                        </a>

                        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                            @article.ContentMarkdown
                        </p>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[11px] text-slate-400 font-medium">📅 @article.CreatedAt.ToString("MMM dd, yyyy")</span>
                        <a asp-controller="Articles" asp-action="Details" asp-route-id="@article.Id" class="text-xs font-extrabold text-teal-800 hover:text-teal-900 transition">
                            পড়ুন ➔
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>
