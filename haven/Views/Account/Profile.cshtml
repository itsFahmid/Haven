@model Haven.Models.UserProfileViewModel
@{
    ViewData["Title"] = "প্রোফাইল | Profile";
}

<div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- Profile Header Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-teal-900 via-slate-900 to-teal-950 text-white p-8 md:p-10 shadow-2xl border border-teal-800/40">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            
            <div class="flex items-center gap-5">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-teal-500 to-emerald-400 text-teal-950 flex items-center justify-center text-3xl font-black shadow-lg">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "H" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <h1 class="text-2xl sm:text-3xl font-black text-white">@Model.FullName</h1>
                        <span class="px-2.5 py-0.5 text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full">
                            🛡️ Verified Member
                        </span>
                    </div>
                    <p class="text-sm text-slate-300">@Model.Email</p>
                    <p class="text-xs text-slate-400">
                        <span data-bn="যোগদানের তারিখ:" data-en="Joined:">যোগদানের তারিখ:</span> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                    </p>
                </div>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-3">
                <a asp-controller="Courses" asp-action="Index" class="px-4 py-2.5 bg-teal-700 hover:bg-teal-600 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-1.5">
                    <span>🎓</span>
                    <span data-bn="কোর্স সমূহ" data-en="Browse Courses">কোর্স সমূহ</span>
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-4 py-2.5 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 border border-rose-500/30 font-bold text-xs rounded-xl transition flex items-center gap-1.5">
                        <span>🚪</span>
                        <span data-bn="লগআউট" data-en="Log Out">লগআউট</span>
                    </button>
                </form>
            </div>

        </div>
    </div>

    <!-- User Dashboard Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Metric 1: Protected Status -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-teal-100 text-teal-800 flex items-center justify-center text-lg font-bold">
                    🔒
                </span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Active</span>
            </div>
            <h3 class="text-sm font-bold text-slate-700" data-bn="অ্যাকাউন্ট নিরাপত্তা স্তর" data-en="Security Status">অ্যাকাউন্ট নিরাপত্তা স্তর</h3>
            <p class="text-2xl font-extrabold text-slate-900 mt-1">100% Encrypted</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="আপনার পরিচয় হেভেনের জিরো-লগ ডেটাবেজে সংরক্ষিত।" data-en="Zero logs recorded. Protected with PBKDF2 encryption.">
                আপনার পরিচয় হেভেনের জিরো-লগ ডেটাবেজে সংরক্ষিত।
            </p>
        </div>

        <!-- Metric 2: Enrolled Safety Modules -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-sky-100 text-sky-800 flex items-center justify-center text-lg font-bold">
                    📚
                </span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-100 text-sky-800">Learning</span>
            </div>
            <h3 class="text-sm font-bold text-slate-700" data-bn="সম্পন্ন সুরক্ষা পাঠ" data-en="Completed Safety Modules">সম্পন্ন সুরক্ষা পাঠ</h3>
            <p class="text-2xl font-extrabold text-teal-800 mt-1">2 / 4 Courses</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="সাইবার ব্ল্যাকমেইল ও মানসিক চাপ নিয়ন্ত্রণ মডিউল সম্পন্ন হয়েছে।" data-en="Cyber blackmail & mental resilience modules in progress.">
                সাইবার ব্ল্যাকমেইল ও মানসিক চাপ নিয়ন্ত্রণ মডিউল সম্পন্ন হয়েছে।
            </p>
        </div>

        <!-- Metric 3: Confidential Therapy Bookings -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-purple-100 text-purple-800 flex items-center justify-center text-lg font-bold">
                    💚
                </span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800">Subsidized</span>
            </div>
            <h3 class="text-sm font-bold text-slate-700" data-bn="থেরাপি বুকিং হিস্ট্রি" data-en="Therapy Bookings">থেরাপি বুকিং হিস্ট্রি</h3>
            <p class="text-2xl font-extrabold text-slate-900 mt-1">1 Confirmed Slot</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="বিএমডিসি ভেরিফায়েড কাউন্সেলরের সাথে পরবর্তী সেশন নির্ধারিত।" data-en="Next confidential session scheduled with BMDC specialist.">
                বিএমডিসি ভেরিফায়েড কাউন্সেলরের সাথে পরবর্তী সেশন নির্ধারিত।
            </p>
        </div>

    </div>

    <!-- Quick Shortcuts Banner -->
    <div class="bg-gradient-to-br from-teal-50 to-emerald-50 rounded-3xl p-8 border border-teal-100 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
            <h2 class="text-lg font-bold text-teal-950" data-bn="আপনার সুরক্ষা সবার আগে" data-en="Your Safety is Always First">আপনার সুরক্ষা সবার আগে</h2>
            <p class="text-xs text-teal-800 mt-1" data-bn="যেকোনো জরুরি প্রয়োজনে আমাদের হটলাইন বা এআই চ্যাটবট সার্বক্ষণিক প্রস্তুত রয়েছে।" data-en="AI hotline and toll-free emergency helplines are available 24/7.">
                যেকোনো জরুরি প্রয়োজনে আমাদের হটলাইন বা এআই চ্যাটবট সার্বক্ষণিক প্রস্তুত রয়েছে।
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Hotline" asp-action="Index" class="px-5 py-3 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2">
                <span>🤖</span>
                <span data-bn="এআই সুরক্ষা হটলাইন" data-en="AI Safety Hotline">এআই সুরক্ষা হটলাইন</span>
            </a>
            <a asp-controller="Therapy" asp-action="Index" class="px-5 py-3 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 font-bold text-xs rounded-2xl transition flex items-center gap-2">
                <span>🩺</span>
                <span data-bn="থেরাপিস্ট ডিরেক্টরি" data-en="Therapy Directory">থেরাপিস্ট ডিরেক্টরি</span>
            </a>
        </div>
    </div>

</div>
