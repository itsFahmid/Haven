@model Haven.Models.UserProfileViewModel
@{
    ViewData["Title"] = "প্রোফাইল | Profile";
}

<div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- Profile Header Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 text-white p-8 md:p-10 shadow-lg border border-slate-800">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            
            <div class="flex items-center gap-5">
                <div class="w-20 h-20 rounded-2xl bg-teal-700 text-white flex items-center justify-center text-3xl font-black shadow-md shrink-0">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "H" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <h1 class="text-2xl sm:text-3xl font-black text-white">@Model.FullName</h1>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <span>Verified Member</span>
                        </span>
                    </div>
                    <p class="text-sm text-slate-300">@Model.Email</p>
                    <p class="text-xs text-slate-400">
                        <span data-bn="যোগদানের তারিখ:" data-en="Joined:">যোগদানের তারিখ:</span> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                    </p>
                </div>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-3">
                <a asp-controller="Courses" asp-action="Index" class="px-4 py-2.5 bg-teal-700 hover:bg-teal-600 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span data-bn="কোর্স সমূহ" data-en="Browse Courses">কোর্স সমূহ</span>
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs rounded-xl transition flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        <span data-bn="লগআউট" data-en="Log Out">লগআউট</span>
                    </button>
                </form>
            </div>

        </div>
    </div>

    <!-- User Dashboard Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Metric 1: Protected Status -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Active</span>
            </div>
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-bn="অ্যাকাউন্ট নিরাপত্তা স্তর" data-en="Security Status">অ্যাকাউন্ট নিরাপত্তা স্তর</h3>
            <p class="text-2xl font-extrabold text-slate-900 mt-1">100% Encrypted</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="আপনার পরিচয় হেভেনের জিরো-লগ ডাটাবেজে সংরক্ষিত।" data-en="Zero logs recorded. Protected with PBKDF2 encryption.">
                আপনার পরিচয় হেভেনের জিরো-লগ ডাটাবেজে সংরক্ষিত।
            </p>
        </div>

        <!-- Metric 2: Enrolled Safety Modules -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-sky-50 text-sky-800 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-100 text-sky-800">Learning</span>
            </div>
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-bn="সম্পন্ন সুরক্ষা পাঠ" data-en="Completed Safety Modules">সম্পন্ন সুরক্ষা পাঠ</h3>
            <p class="text-2xl font-extrabold text-teal-800 mt-1">2 / 4 Courses</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="সাইবার ব্ল্যাকমেইল ও মানসিক চাপ নিয়ন্ত্রণ মডিউল সম্পন্ন হয়েছে।" data-en="Cyber blackmail & mental resilience modules in progress.">
                সাইবার ব্ল্যাকমেইল ও মানসিক চাপ নিয়ন্ত্রণ মডিউল সম্পন্ন হয়েছে।
            </p>
        </div>

        <!-- Metric 3: Confidential Therapy Bookings -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 haven-card">
            <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-900">Subsidized</span>
            </div>
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-bn="থেরাপি বুকিং হিস্ট্রি" data-en="Therapy Bookings">থেরাপি বুকিং হিস্ট্রি</h3>
            <p class="text-2xl font-extrabold text-slate-900 mt-1">1 Confirmed Slot</p>
            <p class="text-xs text-slate-500 mt-2" data-bn="বিএমডিসি ভেরিফায়েড কাউন্সেলরের সাথে পরবর্তী সেশন নির্ধারিত।" data-en="Next confidential session scheduled with BMDC specialist.">
                বিএমডিসি ভেরিফায়েড কাউন্সেলরের সাথে পরবর্তী সেশন নির্ধারিত।
            </p>
        </div>

    </div>

    <!-- Quick Shortcuts Banner -->
    <div class="bg-slate-50 rounded-3xl p-8 border border-slate-200 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
            <h2 class="text-lg font-bold text-slate-900" data-bn="আপনার সুরক্ষা সবার আগে" data-en="Your Safety is Always First">আপনার সুরক্ষা সবার আগে</h2>
            <p class="text-xs text-slate-600 mt-1" data-bn="যেকোনো জরুরি প্রয়োজনে আমাদের হটলাইন বা এআই চ্যাটবট সার্বক্ষণিক প্রস্তুত রয়েছে।" data-en="AI hotline and toll-free emergency helplines are available 24/7.">
                যেকোনো জরুরি প্রয়োজনে আমাদের হটলাইন বা এআই চ্যাটবট সার্বক্ষণিক প্রস্তুত রয়েছে।
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Hotline" asp-action="Index" class="px-5 py-3 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                <span data-bn="এআই সুরক্ষা হটলাইন" data-en="AI Safety Hotline">এআই সুরক্ষা হটলাইন</span>
            </a>
            <a asp-controller="Therapy" asp-action="Index" class="px-5 py-3 bg-white hover:bg-slate-100 text-slate-800 border border-slate-200 font-bold text-xs rounded-xl transition flex items-center gap-2">
                <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span data-bn="থেরাপিস্ট ডিরেক্টরি" data-en="Therapy Directory">থেরাপিস্ট ডিরেক্টরি</span>
            </a>
        </div>
    </div>

</div>
