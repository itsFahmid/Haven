@model Haven.Models.LoginViewModel
@{
    ViewData["Title"] = "লগইন | Log In";
}

<div class="min-h-[calc(100vh-160px)] py-12 px-4 sm:px-6 lg:px-8 flex items-center justify-center bg-[#fdfcf9]">

    <div class="max-w-md w-full space-y-8">
        
        <!-- Header -->
        <div class="text-center space-y-3">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-teal-700 text-white shadow-lg shadow-teal-900/20">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </div>

            <h1 class="text-3xl font-black text-slate-900 tracking-tight" data-bn="হেভেনে স্বাগতম" data-en="Welcome Back to Haven">
                হেভেনে স্বাগতম
            </h1>
            
            <p class="text-sm text-slate-500 max-w-sm mx-auto" data-bn="আপনার সংরক্ষিত কোর্স ও মানসিক স্বাস্থ্য সহায়তায় অ্যাক্সেস করতে লগইন করুন।" data-en="Log in to access your saved progress, course certificates, and therapy appointments.">
                আপনার সংরক্ষিত কোর্স ও মানসিক স্বাস্থ্য সহায়তায় অ্যাক্সেস করতে লগইন করুন।
            </p>
        </div>

        <!-- Form Card Container -->
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-slate-200">
            
            <!-- Server-Side Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-sm font-semibold text-amber-900 bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 @(ViewData.ModelState.IsValid ? "hidden" : "")"></div>

            <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="space-y-5" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email Field -->
                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">
                        <span data-bn="ইমেইল ঠিকানা" data-en="Email Address">ইমেইল ঠিকানা</span> <span class="text-amber-700" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <input asp-for="Email" type="email" class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition" 
                               placeholder="example@haven.org" required />
                    </div>
                    <span asp-validation-for="Email" class="text-xs font-medium text-amber-800 mt-1.5 block"></span>
                </div>

                <!-- Password Field -->
                <div>
                    <label asp-for="Password" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">
                        <span data-bn="পাসওয়ার্ড" data-en="Password">পাসওয়ার্ড</span> <span class="text-amber-700" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <input asp-for="Password" id="loginPasswordInput" type="password" class="w-full pl-10 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent transition" 
                               placeholder="••••••••" required />
                        <button type="button" id="togglePasswordBtn" onclick="togglePasswordVisibility('loginPasswordInput', this)" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-r-xl" aria-label="Toggle password visibility">
                            <svg id="eyeIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs font-medium text-amber-800 mt-1.5 block"></span>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="flex items-center pt-1">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 rounded text-teal-700 focus:ring-teal-500 border-slate-300 cursor-pointer" />
                        <span class="text-sm text-slate-600 select-none" data-bn="আমাকে মনে রাখুন" data-en="Remember me">
                            আমাকে মনে রাখুন
                        </span>
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="w-full py-3.5 px-6 bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span data-bn="লগইন করুন" data-en="Log In Safely">লগইন করুন</span>
                    </button>
                </div>

            </form>

            <!-- Card Footer Switch to Sign Up -->
            <div class="mt-6 pt-5 border-t border-slate-100 text-center">
                <p class="text-sm text-slate-500">
                    <span data-bn="এখনও কোনো অ্যাকাউন্ট নেই?" data-en="Don't have an account yet?">এখনও কোনো অ্যাকাউন্ট নেই?</span>
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="ml-1.5 text-teal-700 hover:text-teal-800 font-bold transition" data-bn="নতুন অ্যাকাউন্ট খুলুন" data-en="Create Account">
                        নতুন অ্যাকাউন্ট খুলুন →
                    </a>
                </p>
            </div>

        </div>

        <!-- Emergency anonymous safe notice -->
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 flex items-start gap-3 text-sm text-amber-900">
            <svg class="w-4 h-4 text-amber-700 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>
                <span class="font-bold" data-bn="জরুরি সংকট বার্তা:" data-en="Emergency Crisis Notice:">জরুরি সংকট বার্তা:</span>
                <span class="ml-1" data-bn="জরুরি মুহূর্তে সাহায্যের জন্য কোনো লগইন প্রয়োজন নেই। সরাসরি ১০৯৮ বা ৯৯৯ এ কল করুন।" data-en="No login required for immediate crisis assistance. Call 1098 or 999 anytime.">
                    জরুরি মুহূর্তে সাহায্যের জন্য কোনো লগইন প্রয়োজন নেই। সরাসরি ১০৯৮ বা ৯৯৯ এ কল করুন।
                </span>
            </span>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById('eyeIcon');
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />';
                } else {
                    input.type = 'password';
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
                }
            }
        }
    </script>
}
