@model Haven.Models.CourseViewModel
@{
    ViewData["Title"] = Model.TitleBn + " | " + Model.TitleEn;
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a asp-action="Index" class="hover:text-teal-700">← <span data-bn="সকল কোর্স" data-en="Back to Courses">সকল কোর্স</span></a>
        <span>/</span>
        <span class="text-slate-800" data-bn="@Model.CategoryBn" data-en="@Model.CategoryEn">@Model.CategoryBn</span>
    </div>

    <!-- Course Header Card -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-800 border border-teal-200" data-bn="@Model.CategoryBn" data-en="@Model.CategoryEn">
                    @Model.CategoryBn
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700" data-bn="@Model.TargetGenBn" data-en="@Model.TargetGen">
                    @Model.TargetGenBn
                </span>
            </div>

            @if (Model.IsFree)
            {
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200" data-bn="১০০% বিনামূল্যে" data-en="100% FREE">
                    ১০০% বিনামূল্যে
                </span>
            }
            else
            {
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200" data-bn="ঐচ্ছিক ফি (PWYW)" data-en="Pay-What-You-Want">
                    ঐচ্ছিক ফি (PWYW)
                </span>
            }
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight" data-bn="@Model.TitleBn" data-en="@Model.TitleEn">
            @Model.TitleBn
        </h1>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed" data-bn="@Model.DescriptionBn" data-en="@Model.DescriptionEn">
            @Model.DescriptionBn
        </p>

        <!-- Key Outcomes -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3" data-bn="এই কোর্স থেকে আপনি যা শিখবেন" data-en="Key Learning Outcomes">
                এই কোর্স থেকে আপনি যা শিখবেন
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
                @for (int i = 0; i < Model.KeyLearningsBn.Count; i++)
                {
                    <li class="flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-teal-700 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                        <span data-bn="@Model.KeyLearningsBn[i]" data-en="@Model.KeyLearningsEn[i]">@Model.KeyLearningsBn[i]</span>
                    </li>
                }
            </ul>
        </div>

        <!-- Lesson Steps -->
        <div class="space-y-3 pt-2">
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-bn="কোর্স মডিউল ও লেসন তালিকা" data-en="Course Modules & Lessons">
                কোর্স মডিউল ও লেসন তালিকা
            </h3>

            <div class="space-y-3">
                @foreach (var mod in Model.Modules)
                {
                    <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white transition flex items-center justify-between">
                        <div class="flex items-center gap-3.5">
                            <span class="w-8 h-8 rounded-xl bg-teal-700 text-white font-bold text-xs flex items-center justify-center">
                                @mod.StepNumber
                            </span>
                            <div>
                                <h4 class="font-bold text-slate-800 text-xs sm:text-sm" data-bn="@mod.TitleBn" data-en="@mod.TitleEn">
                                    @mod.TitleBn
                                </h4>
                                <span class="text-[11px] text-teal-700 font-medium" data-bn="@mod.TypeBn" data-en="@mod.Type">
                                    @mod.TypeBn
                                </span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-slate-400">@mod.DurationBn</span>
                    </div>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <button type="button" onclick="showToast('কোর্সটি আপনার অফলাইন ব্রাউজার সেশনে প্রস্তুত করা হয়েছে!')" class="px-6 py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs" data-bn="ইন্টারেক্টিভ লেসন শুরু করুন" data-en="Launch Interactive Lesson">
                ইন্টারেক্টিভ লেসন শুরু করুন
            </button>
            <button type="button" onclick="openModal('paymentModal')" class="px-5 py-3.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm rounded-xl transition flex items-center gap-2" data-bn="এই কোর্সটি অন্য সহপাঠীর জন্য স্পন্সর করুন" data-en="Sponsor This Course for Others">
                <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                <span data-bn="এই কোর্সটি অন্য সহপাঠীর জন্য স্পন্সর করুন" data-en="Sponsor This Course for Others">এই কোর্সটি অন্য সহপাঠীর জন্য স্পন্সর করুন</span>
            </button>
        </div>

    </div>

</div>
