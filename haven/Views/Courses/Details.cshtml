@model Haven.Models.CourseViewModel
@{
    ViewData["Title"] = Model.TitleBn + " | Course Details";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a asp-action="Index" class="hover:text-teal-700 font-bold">← <span data-bn="সকল কোর্স (All Courses)" data-en="Back to Courses">সকল কোর্স</span></a>
        <span>/</span>
        <span class="text-teal-800 font-bold">@Model.CategoryBn</span>
        <span>/</span>
        <span class="text-slate-700 truncate max-w-xs">@Model.TitleBn</span>
    </div>

    <!-- Comprehensive Course Header Card -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg space-y-8 relative overflow-hidden">
        
        <!-- Top Badges, Language Tag & Pricing -->
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2.5">
                <!-- Mandatory Age Range Tag -->
                <span class="px-4 py-1.5 rounded-full text-xs font-extrabold bg-teal-50 text-teal-900 border border-teal-200">
                    🏷️ @Model.TargetGen
                </span>
                
                <!-- Mandatory Language Tag -->
                <span class="px-4 py-1.5 rounded-full text-xs font-extrabold bg-sky-50 text-sky-900 border border-sky-200">
                    🌐 ভাষা: @Model.LanguageBn
                </span>

                <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    @Model.CategoryBn (@Model.CategoryEn)
                </span>

                <span class="flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold text-amber-500 bg-amber-50 border border-amber-200">
                    ★ @Model.Rating.ToString("0.0") / 5.0
                </span>
            </div>

            <div>
                @if (Model.IsFree)
                {
                    <span class="px-4 py-1.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 uppercase tracking-wider">
                        FREE / ১০০% বিনামূল্যে
                    </span>
                }
                else
                {
                    <span class="px-4 py-1.5 rounded-full text-xs font-black bg-purple-100 text-purple-800 uppercase tracking-wider">
                        PWYW / সাধ্যমতো অনুদান
                    </span>
                }
            </div>
        </div>

        <!-- Titles & Author Info -->
        <div class="space-y-3">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
                @Model.TitleBn
            </h1>
            <p class="text-sm sm:text-base font-bold text-slate-500">@Model.TitleEn</p>
            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 font-semibold pt-1">
                <span>লেখক/থেরাপিস্ট: <strong class="text-slate-900 font-bold">@Model.AuthorName</strong></span>
                <span>•</span>
                <span>⏱️ মোট সময়: <strong class="text-slate-900 font-bold">@Model.Duration</strong></span>
                <span>•</span>
                <span>📚 মডিউল সংখ্যা: <strong class="text-slate-900 font-bold">@Model.ModuleCount টি মডিউল</strong></span>
            </div>
        </div>

        <!-- Full Course Description -->
        <div class="space-y-2 pt-2 border-t border-slate-100">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-500">কোর্সের বিস্তারিত বিবরণ (Course Description)</h3>
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                @Model.DescriptionBn
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.DescriptionEn) && Model.DescriptionEn != Model.DescriptionBn)
            {
                <p class="text-xs text-slate-500 leading-relaxed pt-1">
                    @Model.DescriptionEn
                </p>
            }
        </div>

        <!-- Tags List -->
        @if (Model.Tags.Any())
        {
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <span class="text-xs font-bold text-slate-500">ট্যাগ সমূহ:</span>
                @foreach (var tag in Model.Tags)
                {
                    <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-xl text-xs font-semibold">
                        #@tag
                    </span>
                }
            </div>
        }

        <!-- Big CTA Enrollment Box -->
        <div class="p-6 sm:p-8 bg-slate-900 text-white rounded-3xl shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="space-y-1">
                <h4 class="text-base sm:text-lg font-black">
                    @(Model.IsUserEnrolled ? "আপনি এই কোর্সে এনরোলকৃত আছেন ✓" : "এখনই শিখতে শুরু করুন (Start Learning)")
                </h4>
                <p class="text-xs text-slate-300">
                    @(Model.IsUserEnrolled ? "আপনার 'আমার কোর্স সমূহ' সেকশনে গিয়ে সম্পূর্ণ পাঠ্যসূচী ও সহায়ক রিসোর্স ফাইল এক্সেস করুন।" : "ফ্রিতে এনরোল করে প্রতিটি মডিউলের বিস্তারিত পাঠ ও রিসোর্স ফাইল আনলক করুন।")
                </p>
            </div>

            @if (Model.IsUserEnrolled)
            {
                <a asp-action="MyCourses" class="px-6 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs rounded-2xl transition shadow-lg shrink-0">
                    আমার কোর্সে প্রবেশ করুন ➔
                </a>
            }
            else
            {
                <a asp-action="Enroll" asp-route-id="@Model.Id" class="px-6 py-3.5 bg-teal-500 hover:bg-teal-400 text-slate-950 font-black text-xs rounded-2xl transition shadow-lg shrink-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>ফ্রিতে এনরোল করুন ➔</span>
                    }
                    else
                    {
                        <span>লগইন করে ফ্রিতে এনরোল করুন 🔐</span>
                    }
                </a>
            }
        </div>

    </div>

    <!-- Modules Overview Section with Short Description -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-black text-slate-900">কোর্স মডিউল সমূহের তালিকা (Module Outline)</h3>
                <p class="text-xs text-slate-500">এনরোলমেন্টের পর 'আমার কোর্স সমূহ' সেকশন থেকে সম্পূর্ণ লেসন ও ফাইল এক্সেস করতে পারবেন</p>
            </div>
            <span class="px-3 py-1 bg-teal-50 text-teal-800 rounded-full text-xs font-bold">
                @Model.ModuleCount Modules Total
            </span>
        </div>

        <div class="space-y-4">
            @foreach (var mod in Model.Modules)
            {
                <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4">
                            <span class="w-10 h-10 rounded-2xl bg-teal-800 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-xs mt-0.5">
                                @mod.StepNumber
                            </span>
                            <div class="space-y-1">
                                <h4 class="text-sm font-black text-slate-900">@mod.TitleBn</h4>
                                <p class="text-xs text-slate-500 font-semibold">@mod.TitleEn • ⏱️ @mod.Duration</p>
                                
                                @if (!string.IsNullOrWhiteSpace(mod.ShortDescriptionBn))
                                {
                                    <p class="text-xs text-slate-700 leading-relaxed pt-1">
                                        💡 @mod.ShortDescriptionBn
                                    </p>
                                }
                            </div>
                        </div>

                        <span class="text-[11px] font-bold text-slate-400 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shrink-0">
                            🔒 এনরোল করে পাঠ গ্রহণ করুন
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Student Reviews & Rating Section -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-black text-slate-900">শিক্ষার্থীদের রিভিউ ও রেটিং (Student Reviews & Feedback)</h3>
                <p class="text-xs text-slate-500">এই কোর্সটি সম্পন্ন করা শিক্ষার্থীদের বাস্তব অভিজ্ঞতা ও স্টার রেটিং</p>
            </div>
            <div class="flex items-center gap-2 bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200 text-xs font-black text-amber-900">
                <span>★ @Model.Rating.ToString("0.0")</span>
                <span>/ 5.0 Stars</span>
            </div>
        </div>

        @if (!Model.Reviews.Any())
        {
            <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100 space-y-2">
                <div class="text-2xl">⭐</div>
                <h4 class="text-xs font-bold text-slate-700">এখনো কোনো রিভিউ দেওয়া হয়নি</h4>
                <p class="text-[11px] text-slate-500">আপনি কোর্সটিতে এনরোল করে সম্পন্ন করার পর আপনার প্রথম মূল্যবান রিভিউ যুক্ত করতে পারবেন!</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var rev in Model.Reviews)
                {
                    <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-full bg-teal-700 text-white font-bold text-xs flex items-center justify-center">
                                    @(string.IsNullOrWhiteSpace(rev.UserName) ? "Y" : rev.UserName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <h5 class="text-xs font-bold text-slate-900">@rev.UserName</h5>
                                    <span class="text-[10px] text-slate-400">@rev.CreatedAt.ToString("dd MMM, yyyy")</span>
                                </div>
                            </div>

                            <div class="text-amber-500 font-extrabold text-sm">
                                @string.Concat(Enumerable.Repeat("★", rev.Rating))
                            </div>
                        </div>

                        <p class="text-xs text-slate-700 leading-relaxed pt-1">
                            "@rev.Comment"
                        </p>
                    </div>
                }
            </div>
        }
    </div>

</div>
