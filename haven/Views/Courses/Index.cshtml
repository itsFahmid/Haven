@model Haven.Models.CoursesHubViewModel
@{
    ViewData["Title"] = "সুরক্ষা ও জীবন-দক্ষতা কোর্স হাব | Courses Hub";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">

    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 text-white p-8 sm:p-12 shadow-xl border border-slate-800">
        <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div class="max-w-3xl space-y-4">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-xs font-extrabold uppercase tracking-wider">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    <span>Youth Safety & Resilience Academy</span>
                </span>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight" data-bn="সুরক্ষা ও জীবন-দক্ষতা কোর্স হাব" data-en="Safety & Life-Skills Educational Hub">
                    সুরক্ষা ও জীবন-দক্ষতা কোর্স হাব
                </h1>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed" data-bn="জেন জি, জেন আলফা এবং তরুণ অভিভাবকদের জন্য তৈরি প্র্যাকটিক্যাল কোর্স। সাইবার বুলিং প্রতিরক্ষা, প্রমাণ সংগ্রহ, ব্যক্তিগত সম্মতি ও মানসিক স্থিতিস্থাপকতার আধুনিক পাঠ।" data-en="Practical trauma-informed safety courses for youth. Learn evidence preservation, cyber harassment defense, consent boundary setting, and panic stabilization.">
                    জেন জি, জেন আলফা এবং তরুণ অভিভাবকদের জন্য তৈরি প্র্যাকটিক্যাল কোর্স। সাইবার বুলিং প্রতিরক্ষা, প্রমাণ সংগ্রহ, ব্যক্তিগত সম্মতি ও মানসিক স্থিতিস্থাপকতার আধুনিক পাঠ।
                </p>

                <div class="flex flex-wrap items-center gap-6 pt-2 text-xs font-semibold text-slate-300">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                        <span data-bn="১৮,৪৫০+ নিবন্ধিত শিক্ষার্থী" data-en="18,450+ Active Youth Learners">১৮,৪৫০+ নিবন্ধিত শিক্ষার্থী</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                        <span data-bn="ফ্রি ও ঐচ্ছিক Pay-What-You-Want" data-en="100% Free & Pay-What-You-Want">ফ্রি ও ঐচ্ছিক Pay-What-You-Want</span>
                    </div>
                </div>
            </div>

            <!-- Header Action & Publishing Portal for Therapists -->
            <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="MyCourses" class="px-6 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs rounded-2xl shadow-lg transition flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
                        <span data-bn="আমার এনরোলকৃত কোর্স সমূহ" data-en="My Enrolled Courses">আমার এনরোলকৃত কোর্স সমূহ</span>
                    </a>
                }

                @if (User.IsInRole("Professional") || User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="px-6 py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs rounded-2xl shadow-lg transition flex items-center justify-center gap-2 border border-amber-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                        <span data-bn="নতুন কোর্স প্রকাশ করুন (থেরাপিস্ট)" data-en="Publish New Course (Therapist)">নতুন কোর্স প্রকাশ করুন (থেরাপিস্ট)</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Login Guest Warning Banner -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="p-4 rounded-2xl bg-teal-50 border border-teal-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-teal-950">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-teal-700 text-white flex items-center justify-center shrink-0 font-bold">
                    🔐
                </span>
                <div>
                    <h3 class="font-bold text-teal-950" data-bn="কোর্সের পাঠে সরাসরি প্রবেশাধিকার সুরক্ষিত" data-en="Course Lesson Access is Protected">কোর্সের পাঠে সরাসরি প্রবেশাধিকার সুরক্ষিত</h3>
                    <p class="text-teal-800 text-[11px]" data-bn="যেকোনো কোর্সে ফ্রিতে এনরোল করতে ও আপনার শিখন অগ্রগতি সংরক্ষণ করতে অনুগ্রহ করে প্রথমে একটি অ্যাকাউন্টে লগইন করুন।" data-en="Courses are free to browse. Please log in or register to enroll and unlock interactive module lessons.">
                        যেকোনো কোর্সে ফ্রিতে এনরোল করতে ও আপনার শিখন অগ্রগতি সংরক্ষণ করতে অনুগ্রহ করে প্রথমে একটি অ্যাকাউন্টে লগইন করুন।
                    </p>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Login" class="px-4 py-2 bg-teal-800 text-white font-bold text-xs rounded-xl hover:bg-teal-900 transition shrink-0">
                লগইন / Sign In ➔
            </a>
        </div>
    }

    <!-- Search & Filter Bar (Minimal - Category pills removed as requested) -->
    <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
            
            <!-- Search Keyword -->
            <div class="md:col-span-5 relative">
                <input type="text" name="search" value="@Model.SearchQuery" placeholder="কোর্সের শিরোনাম বা কিউয়ার্ড খুঁজুন / Search courses..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none" />
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>

            <!-- Mandatory Age Group Filter Tag -->
            <div class="md:col-span-3">
                <select name="ageGroup" onchange="this.form.submit()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    <option value="All" selected="@(Model.SelectedAgeGroup == "All")">সকল বয়স শ্রেণী (All Age Ranges)</option>
                    <option value="Gen Z & Alpha (10-24y)" selected="@(Model.SelectedAgeGroup == "Gen Z & Alpha (10-24y)")">🏷️ Gen Z & Alpha (10-24y)</option>
                    <option value="Young Adults (18-25y)" selected="@(Model.SelectedAgeGroup == "Young Adults (18-25y)")">🏷️ Young Adults (18-25y)</option>
                    <option value="Parents & Guardians" selected="@(Model.SelectedAgeGroup == "Parents & Guardians")">🏷️ Parents & Guardians</option>
                </select>
            </div>

            <!-- Category Filter Dropdown -->
            <div class="md:col-span-3">
                <select name="category" onchange="this.form.submit()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    <option value="All" selected="@(Model.SelectedCategory == "All")">সকল বিষয়শ্রেণী (All Categories)</option>
                    <option value="Cyber Safety" selected="@(Model.SelectedCategory == "Cyber Safety")">সাইবার নিরাপত্তা (Cyber Safety)</option>
                    <option value="Personal Safety" selected="@(Model.SelectedCategory == "Personal Safety")">ব্যক্তিগত সুরক্ষা (Personal Safety)</option>
                    <option value="Mental Health" selected="@(Model.SelectedCategory == "Mental Health")">মানসিক স্বাস্থ্য (Mental Health)</option>
                    <option value="Parenting & Guidance" selected="@(Model.SelectedCategory == "Parenting & Guidance")">অভিভাবকত্ব (Parenting & Guidance)</option>
                </select>
            </div>

            <div class="md:col-span-1">
                <button type="submit" class="w-full py-2.5 bg-slate-900 text-white rounded-2xl text-xs font-bold hover:bg-slate-800 transition">
                    Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Courses Grid (Minimalist Cards) -->
    @if (!Model.Courses.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-slate-200 space-y-4">
            <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto text-2xl font-bold">
                🔍
            </div>
            <h3 class="text-lg font-bold text-slate-800" data-bn="কোনো অনুমোদিত কোর্স পাওয়া যায়নি" data-en="No Approved Courses Found">কোনো অনুমোদিত কোর্স পাওয়া যায়নি</h3>
            <p class="text-xs text-slate-500 max-w-md mx-auto">আপনার ফিল্টারের সাথে মিলে এমন কোনো কোর্স পাওয়া যায়নি। অনুগ্রহ করে অন্য ফিল্টার চেষ্টা করুন।</p>
            <a asp-action="Index" class="inline-block px-4 py-2 bg-teal-800 text-white text-xs font-bold rounded-xl hover:bg-teal-900 transition">
                সকল কোর্স দেখুন
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var course in Model.Courses)
            {
                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    
                    <a asp-action="Details" asp-route-id="@course.Id" class="p-6 space-y-4 block">
                        <!-- Top Badges & Ratings -->
                        <div class="flex items-center justify-between gap-2">
                            <!-- Mandatory Age Range Tag -->
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-extrabold bg-teal-50 text-teal-800 border border-teal-200">
                                🏷️ @course.TargetGen
                            </span>

                            <!-- Rating -->
                            <div class="flex items-center gap-1 text-xs font-bold text-amber-500 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200 shrink-0">
                                <span>★</span>
                                <span>@course.Rating.ToString("0.0")</span>
                                <span class="text-[10px] text-slate-400 font-normal">(5.0)</span>
                            </div>
                        </div>

                        <!-- Course Title -->
                        <div class="space-y-1.5">
                            <span class="text-[10px] uppercase tracking-wider font-extrabold text-teal-700">@course.CategoryBn • @course.CategoryEn</span>
                            <h3 class="text-base sm:text-lg font-black text-slate-900 group-hover:text-teal-700 transition line-clamp-2" title="@course.TitleBn">
                                @course.TitleBn
                            </h3>
                            <p class="text-xs text-slate-500 font-semibold line-clamp-1">@course.TitleEn</p>
                        </div>

                        <!-- Minimal Course Description -->
                        <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
                            @course.DescriptionBn
                        </p>

                        <!-- Minimal Duration & Module Metadata Row -->
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-500 pt-2 border-t border-slate-100">
                            <span>⏱️ @course.Duration</span>
                            <span class="text-teal-800 font-black">📚 @course.ModuleCount মডিউল</span>
                        </div>
                    </a>

                    <!-- Footer Pricing & Enrollment Action -->
                    <div class="p-6 pt-0 border-t border-slate-100 mt-2 flex items-center justify-between gap-3">
                        <div>
                            @if (course.IsFree)
                            {
                                <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-black uppercase">
                                    FREE / ফ্রি
                                </span>
                            }
                            else if (course.IsPayWhatYouWant)
                            {
                                <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-black uppercase" title="Pay What You Want">
                                    PWYW / সাধ্যমতো
                                </span>
                            }
                            else
                            {
                                <span class="text-sm font-black text-slate-900">
                                    ৳@course.SuggestedFeeBDT BDT
                                </span>
                            }
                        </div>

                        <div>
                            @if (course.IsUserEnrolled)
                            {
                                <a asp-action="MyCourses" class="px-4 py-2 bg-emerald-700 text-white text-xs font-bold rounded-xl hover:bg-emerald-800 transition shadow-2xs">
                                    আমার কোর্সে দেখুন ✓
                                </a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@course.Id" class="px-4 py-2 bg-teal-800 text-white text-xs font-bold rounded-xl hover:bg-teal-900 transition shadow-2xs">
                                    বিবরণ ও মডিউল ➔
                                </a>
                            }
                        </div>
                    </div>

                </div>
            }
        </div>

        <!-- Pagination System -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
                <p class="text-xs text-slate-500">
                    মোট <strong class="text-slate-800">@Model.TotalCoursesCount</strong> টি কোর্সের মধ্যে পৃষ্ঠা <strong class="text-slate-800">@Model.CurrentPage</strong> / <strong class="text-slate-800">@Model.TotalPages</strong> প্রদর্শিত হচ্ছে।
                </p>

                <div class="flex items-center gap-2">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-category="@Model.SelectedCategory" asp-route-ageGroup="@Model.SelectedAgeGroup" asp-route-search="@Model.SearchQuery" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
                            ◄ পূর্ববর্তী (Prev)
                        </a>
                    }
                    else
                    {
                        <span class="px-3.5 py-2 bg-slate-50 text-slate-300 font-bold text-xs rounded-xl cursor-not-allowed">
                            ◄ পূর্ববর্তী
                        </span>
                    }

                    <!-- Page Numbers -->
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        var isCurrent = p == Model.CurrentPage;
                        <a asp-action="Index" asp-route-page="@p" asp-route-category="@Model.SelectedCategory" asp-route-ageGroup="@Model.SelectedAgeGroup" asp-route-search="@Model.SearchQuery" class="w-8 h-8 flex items-center justify-center font-bold text-xs rounded-xl transition @(isCurrent ? "bg-teal-800 text-white shadow-xs" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                            @p
                        </a>
                    }

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-category="@Model.SelectedCategory" asp-route-ageGroup="@Model.SelectedAgeGroup" asp-route-search="@Model.SearchQuery" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
                            পরবর্তী (Next) ►
                        </a>
                    }
                    else
                    {
                        <span class="px-3.5 py-2 bg-slate-50 text-slate-300 font-bold text-xs rounded-xl cursor-not-allowed">
                            পরবর্তী ►
                        </span>
                    }
                </div>
            </div>
        }
    }

</div>
