@model Haven.Models.TherapyDirectoryViewModel
@{
    ViewData["Title"] = "ভেরিফায়েড থেরাপি ডিরেক্টরি | Verified Therapy Directory";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Hero Header -->
    <div class="bg-gradient-to-r from-emerald-900 via-teal-950 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-3xl relative z-10 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-xs font-extrabold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>BMDC & BCPS Verified Professional Sanctuary</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight" data-bn="ভেরিফায়েড প্রফেশনাল থেরাপি ডিরেক্টরি" data-en="Verified Professional Therapy Directory">
                ভেরিফায়েড প্রফেশনাল থেরাপি ডিরেক্টরি
            </h1>
            <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed" data-bn="বাংলাদেশ মেডিকেল অ্যান্ড ডেন্টাল কাউন্সিল (BMDC) ও ক্লিনিক্যাল সাইকোলজি সোসাইটি কর্তৃক স্বীকৃত মানসিক স্বাস্থ্য বিশেষজ্ঞ। সম্পূর্ণ গোপনীয়তায় এনক্রিপ্টেড ভিডিও কল, অডিও বা সরাসরি চেম্বারে সেবা নিন।" data-en="Connect with certified psychiatrists and clinical psychologists for stigma-free, confidential sessions via end-to-end encrypted video, voice, or in-person clinics.">
                বাংলাদেশ মেডিকেল অ্যান্ড ডেন্টাল কাউন্সিল (BMDC) ও ক্লিনিক্যাল সাইকোলজি সোসাইটি কর্তৃক স্বীকৃত মানসিক স্বাস্থ্য বিশেষজ্ঞ। সম্পূর্ণ গোপনীয়তায় এনক্রিপ্টেড ভিডিও কল, অডিও বা সরাসরি চেম্বারে সেবা নিন।
            </p>

            <div class="flex flex-wrap items-center justify-between gap-6 pt-4 border-t border-emerald-800/60 mt-4">
                <div class="flex flex-wrap items-center gap-6 text-xs font-semibold text-emerald-200">
                    <div class="flex items-center gap-2">
                        <span class="text-emerald-300 text-base">✓</span>
                        <span data-bn="@Model.VerifiedCount জন সার্টিফাইড বিশেষজ্ঞ সক্রিয়" data-en="@Model.VerifiedCount Verified Specialists Active">@Model.VerifiedCount জন সার্টিফাইড বিশেষজ্ঞ সক্রিয়</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-emerald-300 text-base">✓</span>
                        <span data-bn="১০০% পরিচয়হীন ও গোপন বুকিং" data-en="100% Anonymous Booking Option">১০০% পরিচয়হীন ও গোপন বুকিং</span>
                    </div>
                </div>

                <a asp-action="Apply" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs rounded-xl shadow-md transition">
                    <span>👨‍⚕️ আপনি কি সার্টিফাইড থেরাপিস্ট? আবেদন করুন ➔</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider pl-1 whitespace-nowrap" data-bn="বিশেষজ্ঞতা ফিল্টার:" data-en="Specialty:">বিশেষজ্ঞতা:</span>
            <a asp-action="Index" asp-route-specialty="All" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap @(Model.SelectedSpecialty == "All" ? "bg-teal-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-bn="সকল" data-en="All">সকল</a>
            <a asp-action="Index" asp-route-specialty="Adolescent Trauma" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap @(Model.SelectedSpecialty == "Adolescent Trauma" ? "bg-teal-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-bn="কিশোর ট্রমা" data-en="Adolescent Trauma">কিশোর ট্রমা</a>
            <a asp-action="Index" asp-route-specialty="Cyber Harassment" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap @(Model.SelectedSpecialty == "Cyber Harassment" ? "bg-teal-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-bn="সাইবার হয়রানি চিকিৎসা" data-en="Cyber Harassment">সাইবার হয়রানি</a>
            <a asp-action="Index" asp-route-specialty="Child Sexual Abuse" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap @(Model.SelectedSpecialty == "Child Sexual Abuse" ? "bg-teal-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")" data-bn="শিশু নির্যাতন নিরাময়" data-en="Child Abuse Recovery">শিশু নির্যাতন নিরাময়</a>
        </div>

        <div class="text-xs text-slate-500 font-medium">
            <span data-bn="পেমেন্ট: বিকাশ / নগদ / রকেট / ফ্রি স্কলারশিপ" data-en="Gateways: bKash, Nagad, Rocket & Free Subsidy">পেমেন্ট: বিকাশ / নগদ / রকেট / ফ্রি স্কলারশিপ</span>
        </div>
    </div>

    <!-- Therapists Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var therapist in Model.Therapists)
        {
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition haven-card p-6 flex flex-col justify-between">
                
                <div class="space-y-4">
                    
                    <!-- Profile Header -->
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-14 h-14 rounded-2xl bg-teal-700 text-white flex items-center justify-center font-bold text-lg">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-900 leading-tight" data-bn="@therapist.NameBn" data-en="@therapist.NameEn">
                                    @therapist.NameBn
                                </h3>
                                <p class="text-xs text-teal-800 font-medium mt-0.5" data-bn="@therapist.TitleBn" data-en="@therapist.TitleEn">
                                    @therapist.TitleBn
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- BMDC Badge & Reg No -->
                    <div class="flex items-center justify-between p-2.5 bg-emerald-50/70 border border-emerald-200/80 rounded-xl text-xs">
                        <div class="flex items-center gap-1.5 text-emerald-900 font-bold">
                            <span class="w-4 h-4 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px]">✓</span>
                            <span>BMDC Verified</span>
                        </div>
                        <span class="font-mono text-[11px] font-bold text-emerald-800">@therapist.RegistrationNo</span>
                    </div>

                    <!-- Degree & Affiliation -->
                    <div class="text-xs text-slate-600 space-y-1">
                        <div class="flex items-start gap-1.5">
                            <span class="text-slate-400">🎓</span>
                            <span data-bn="@therapist.DegreeBn" data-en="@therapist.DegreeEn">@therapist.DegreeBn</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="text-slate-400">🏥</span>
                            <span data-bn="@therapist.InstitutionBn" data-en="@therapist.InstitutionEn">@therapist.InstitutionBn</span>
                        </div>
                    </div>

                    <!-- Bio -->
                    <p class="text-xs text-slate-600 leading-relaxed line-clamp-3" data-bn="@therapist.BioBn" data-en="@therapist.BioEn">
                        @therapist.BioBn
                    </p>

                    <!-- Specialization Tags -->
                    <div class="space-y-1.5 pt-1">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider" data-bn="বিশেষ পারদর্শিতা:" data-en="Specializations:">বিশেষ পারদর্শিতা:</span>
                        <div class="flex flex-wrap gap-1.5">
                            @for (int i = 0; i < therapist.SpecializationsBn.Count; i++)
                            {
                                <span class="px-2 py-0.5 rounded-lg text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200" data-bn="@therapist.SpecializationsBn[i]" data-en="@therapist.SpecializationsEn[i]">
                                    @therapist.SpecializationsBn[i]
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Consultation Modes -->
                    <div class="flex items-center gap-3 text-xs text-slate-500 pt-1">
                        <span class="font-bold text-slate-700">⭐ @therapist.Rating (@therapist.ReviewCount)</span>
                        <span>•</span>
                        <span>@therapist.ExperienceYears+ Years Exp</span>
                    </div>

                </div>

                <!-- Card Footer: Fee & Booking Trigger -->
                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                    <div>
                        <span class="text-[10px] text-slate-400 block font-semibold" data-bn="পরামর্শ ফি (১ ঘণ্টা)" data-en="Session Fee (1 hr)">পরামর্শ ফি</span>
                        <span class="text-base font-extrabold text-slate-900">৳@therapist.BaseFeeBDT</span>
                    </div>

                    <button type="button" onclick="HavenTherapy.openBookingModal(@therapist.Id, '@therapist.NameEn', '@therapist.NameBn', @therapist.BaseFeeBDT, '@therapist.DegreeEn', '@therapist.DegreeBn')" class="py-2.5 px-4 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl transition shadow-md shadow-teal-900/10" data-bn="স্লট বুক করুন" data-en="Book Slot">
                        স্লট বুক করুন ➔
                    </button>
                </div>

            </div>
        }
    </div>

</div>

<!-- Interactive Slot Selector Modal -->
<div id="therapyBookingModal" class="haven-modal fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/75 backdrop-blur-sm overflow-y-auto" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all my-8">
        
        <div class="p-6 md:p-8 space-y-6">
            
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div>
                    <span class="text-xs font-bold text-teal-700 uppercase tracking-wide" data-bn="গোপনীয় সেশন বুকিং" data-en="Confidential Session Booking">গোপনীয় সেশন বুকিং</span>
                    <h3 id="bookingTherapistName" class="text-lg font-bold text-slate-900 mt-0.5">Therapist Name</h3>
                </div>
                <button onclick="closeModal('therapyBookingModal')" class="text-slate-400 hover:text-slate-700 p-2 rounded-full hover:bg-slate-100 transition">✕</button>
            </div>

            <!-- Date & Slot Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5" data-bn="উপলব্ধ সেশন সময় নির্বাচন করুন" data-en="Select Available Time Slot">
                    উপলব্ধ সেশন সময় নির্বাচন করুন
                </label>
                <div class="grid grid-cols-2 gap-2.5">
                    <button type="button" onclick="HavenTherapy.selectSlot(1, this)" class="therapy-slot-btn py-3 px-3 rounded-xl border border-teal-700 bg-teal-700 text-white font-semibold text-xs text-left transition">
                        <div class="font-bold">আজ (Today)</div>
                        <div class="text-[11px] opacity-90">০৪:৩০ PM - ০৫:৩০ PM</div>
                    </button>
                    <button type="button" onclick="HavenTherapy.selectSlot(2, this)" class="therapy-slot-btn py-3 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                        <div class="font-bold">আজ রাত (Tonight)</div>
                        <div class="text-[11px] text-slate-500">০৯:০০ PM - ১০:০০ PM</div>
                    </button>
                    <button type="button" onclick="HavenTherapy.selectSlot(3, this)" class="therapy-slot-btn py-3 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                        <div class="font-bold">আগামীকাল (Tomorrow)</div>
                        <div class="text-[11px] text-slate-500">১১:০০ AM - ১২:০০ PM</div>
                    </button>
                    <button type="button" onclick="HavenTherapy.selectSlot(4, this)" class="therapy-slot-btn py-3 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                        <div class="font-bold">আগামীকাল (Tomorrow)</div>
                        <div class="text-[11px] text-slate-500">০৬:০০ PM - ০৭:০০ PM</div>
                    </button>
                </div>
            </div>

            <!-- Anonymous Contact Option -->
            <div class="space-y-3">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider" data-bn="গোপনীয় যোগাযোগের মাধ্যম (এনক্রিপ্টেড লিংক পাঠানো হবে)" data-en="Encrypted Meeting Link Destination">
                    গোপনীয় যোগাযোগের মাধ্যম (এনক্রিপ্টেড লিংক পাঠানো হবে)
                </label>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" placeholder="WhatsApp / Signal Number" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-600 focus:outline-none" />
                    <input type="text" placeholder="Alias Name (e.g. Guest #82)" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-600 focus:outline-none" />
                </div>
            </div>

            <!-- Fee & Subsidy Toggle -->
            <div class="p-3.5 bg-teal-50 border border-teal-200 rounded-2xl flex items-center justify-between">
                <div>
                    <span class="text-xs text-slate-600 block" data-bn="নির্ধারিত ফি:" data-en="Standard Fee:">নির্ধারিত ফি:</span>
                    <span id="bookingFeeAmount" class="text-lg font-black text-teal-800">৳৬০০</span>
                </div>
                <button type="button" onclick="showToast('সাবসিডি আবেদন সক্রিয় করা হয়েছে! ফি সম্পূর্ণ মওকুফ হতে পারে।')" class="text-xs text-teal-700 underline font-bold" data-bn="আর্থিক অসচ্ছলতার কারণে ফ্রি স্লট আবেদন" data-en="Request Student Fee Subsidy">
                    ফ্রি স্লট আবেদন
                </button>
            </div>

            <!-- Confirm Booking Button -->
            <button type="button" id="submitBookingBtn" onclick="HavenTherapy.confirmBooking()" class="w-full py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm rounded-xl transition shadow-lg shadow-teal-900/10 flex items-center justify-center gap-2">
                <span data-bn="গোপনীয় সেশন নিশ্চিত করুন" data-en="Confirm Confidential Session">গোপনীয় সেশন নিশ্চিত করুন</span> 🔒
            </button>

        </div>

    </div>
</div>
