@model Haven.Controllers.TherapistDashboardViewModel
@{
    ViewData["Title"] = "প্রফেশনাল থেরাপিস্ট ড্যাশবোর্ড | Professional Dashboard";
    var prof = Model.Profile;
}

<div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- Top Welcome & Verification Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-teal-900/50 relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-teal-600/30 border border-teal-500/40 text-teal-300 flex items-center justify-center text-2xl font-black shadow-inner flex-shrink-0">
                    @(prof.User?.FullName?.Substring(0, 1).ToUpper() ?? "P")
                </div>
                <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider @(prof.ApprovalStatus == "Approved" ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" : "bg-amber-500/20 text-amber-300 border border-amber-500/30")">
                            @(prof.ApprovalStatus == "Approved" ? "✓ BMDC Verified Professional Account" : "⏳ Verification Pending Approval")
                        </span>
                        <span class="px-2.5 py-0.5 bg-slate-800 text-slate-300 rounded-full text-[11px] font-bold border border-slate-700">
                            Reg: @prof.LicenseNo
                        </span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-black tracking-tight">
                        @(prof.User?.FullName ?? prof.TitleEn)
                    </h1>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @prof.TitleEn | @prof.Specialty | @prof.YearsOfExperience Years Experience
                    </p>
                </div>
            </div>

            <!-- Header Quick Actions -->
            <div class="flex flex-wrap items-center gap-3">
                <a asp-controller="Courses" asp-action="Create" class="px-4 py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-1.5 active:scale-97">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>+ কোর্স প্রকাশ করুন</span>
                </a>
                <a asp-controller="Articles" asp-action="Create" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl border border-slate-700 shadow-xs transition flex items-center gap-1.5 active:scale-97">
                    <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    <span>+ নিবন্ধ লিখুন</span>
                </a>
                <a asp-controller="Therapy" asp-action="Index" class="px-4 py-2.5 bg-teal-950/80 hover:bg-slate-900 text-teal-300 font-bold text-xs rounded-xl border border-teal-800/80 transition">
                    পাবলিক প্রোফাইল ➔
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between text-slate-500 text-xs font-semibold">
                <span>মোট বুকিং / Total Appointments</span>
                <span class="p-2 bg-teal-50 text-teal-700 rounded-xl">📅</span>
            </div>
            <div class="text-3xl font-black text-slate-900">@Model.TotalBookingsCount</div>
            <p class="text-[11px] text-teal-700 font-medium">ক্লায়েন্ট কর্তৃক নির্ধারিত সেশন</p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between text-slate-500 text-xs font-semibold">
                <span>আসন্ন সেশন / Pending Sessions</span>
                <span class="p-2 bg-amber-50 text-amber-700 rounded-xl">⏳</span>
            </div>
            <div class="text-3xl font-black text-amber-600">@Model.PendingBookingsCount</div>
            <p class="text-[11px] text-slate-500 font-medium">নির্ধারিত সময়ে উপস্থিতি নিশ্চিত করুন</p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between text-slate-500 text-xs font-semibold">
                <span>ভিজিটিং ফি / Hourly Rate</span>
                <span class="p-2 bg-emerald-50 text-emerald-700 rounded-xl">৳</span>
            </div>
            <div class="text-3xl font-black text-emerald-700">৳ @prof.HourlyRateBDT</div>
            <p class="text-[11px] text-slate-500 font-medium">প্রতি সেশনের জন্য ধার্যকৃত ফি</p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between text-slate-500 text-xs font-semibold">
                <span>প্রকাশিত কন্টেন্ট / Published Hub</span>
                <span class="p-2 bg-sky-50 text-sky-700 rounded-xl">📚</span>
            </div>
            <div class="text-3xl font-black text-slate-900">@(Model.SubmittedCoursesCount + Model.PublishedArticlesCount)</div>
            <p class="text-[11px] text-slate-500 font-medium">@Model.SubmittedCoursesCount টি কোর্স ও @Model.PublishedArticlesCount টি নিবন্ধ</p>
        </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Appointments Management Panel -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900" data-bn="রোগী ও ক্লায়েন্টদের অ্যাপয়েন্টমেন্ট তালিকা" data-en="Client Appointments Schedule">
                            রোগী ও ক্লায়েন্টদের অ্যাপয়েন্টমেন্ট তালিকা
                        </h2>
                        <p class="text-xs text-slate-500">আপনার সাথে বুক করা মানসিক স্বাস্থ্য সেশন সমূহের বিবরণ।</p>
                    </div>
                    <span class="px-3 py-1 bg-teal-50 text-teal-800 text-xs font-bold rounded-xl border border-teal-200">
                        @Model.Appointments.Count Sessions Total
                    </span>
                </div>

                @if (!Model.Appointments.Any())
                {
                    <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200 space-y-2">
                        <div class="text-3xl">💬</div>
                        <p class="text-sm font-bold text-slate-700">এখনো কোনো সেশন বুকিং পাওয়া যায়নি</p>
                        <p class="text-xs text-slate-500">পাবলিক থেরাপি ডিরেক্টরিতে আপনার প্রোফাইল সক্রিয় রয়েছে। রোগীরা বুকিং দিলে এখানে দেখা যাবে।</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider">
                                    <th class="py-3 px-4 rounded-l-xl">আইডি / রেফ</th>
                                    <th class="py-3 px-4">রোগী / ক্লায়েন্ট</th>
                                    <th class="py-3 px-4">তারিখ ও সময়</th>
                                    <th class="py-3 px-4">যোগাযোগের মাধ্যম</th>
                                    <th class="py-3 px-4">স্ট্যাটাস</th>
                                    <th class="py-3 px-4 rounded-r-xl text-right">অ্যাকশন</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium">
                                @foreach (var appt in Model.Appointments)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-4 px-4 font-mono font-bold text-teal-800">
                                            #HVN-@appt.Id
                                        </td>
                                        <td class="py-4 px-4">
                                            <div class="font-bold text-slate-900">@(appt.User?.FullName ?? "Anonymous Patient")</div>
                                            <div class="text-[11px] text-slate-400">@appt.Notes</div>
                                        </td>
                                        <td class="py-4 px-4">
                                            <div class="font-semibold text-slate-800">@appt.ScheduledDate.ToString("MMM dd, yyyy")</div>
                                            <div class="text-teal-700 font-bold">@appt.TimeSlot</div>
                                        </td>
                                        <td class="py-4 px-4">
                                            <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg text-[11px] font-semibold border border-slate-200">
                                                @appt.CommunicationChannel
                                            </span>
                                        </td>
                                        <td class="py-4 px-4">
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider @(appt.Status == "Completed" ? "bg-emerald-100 text-emerald-800" : appt.Status == "Cancelled" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                                @appt.Status
                                            </span>
                                        </td>
                                        <td class="py-4 px-4 text-right space-x-1">
                                            @if (appt.Status != "Cancelled")
                                            {
                                                <form asp-action="CancelAppointment" method="post" class="inline">
                                                    <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                    <button type="submit" onclick="return confirm('আপনি কি এই অ্যাপয়েন্টমেন্ট বাতিল করতে চান?')" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] font-bold rounded-lg transition">
                                                        বাতিল
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Therapist Profile Quick Management Panel -->
        <div class="space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-900" data-bn="প্রফেশনাল প্রোফাইল আপডেট" data-en="Update Profile Settings">
                        প্রফেশনাল প্রোফাইল আপডেট
                    </h3>
                    <p class="text-xs text-slate-500">আপনার চেম্বার/অনলাইন সেশন ফি ও সময়সূচি পরিবর্তন করুন।</p>
                </div>

                <form asp-action="UpdateProfileDetails" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">স্পেশালিটি / Specialty</label>
                        <input type="text" name="specialty" value="@prof.Specialty" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600 focus:bg-white" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">প্রতি সেশন ফি (টাকা) / Hourly Fee (BDT)</label>
                        <input type="number" name="hourlyRateBDT" value="@prof.HourlyRateBDT" min="0" step="50" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600 focus:bg-white" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">কনসালটেশন সময়সূচি / Available Hours</label>
                        <input type="text" name="consultationTime" value="@(prof.ConsultationTime ?? "Sat - Thu: 04:00 PM - 08:00 PM")" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600 focus:bg-white" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">প্রোফাইল বায়ো / Professional Bio</label>
                        <textarea name="bio" rows="3" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-teal-600 focus:bg-white">@prof.Bio</textarea>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-xl shadow-xs transition active:scale-97">
                        পরিবর্তন সংরক্ষণ করুন
                    </button>
                </form>
            </div>

            <!-- Verification Notice Card -->
            <div class="bg-gradient-to-br from-teal-50 to-emerald-50 rounded-3xl p-6 border border-teal-200/80 space-y-3">
                <div class="flex items-center gap-2">
                    <span class="p-2 bg-teal-600 text-white rounded-xl text-xs font-bold">🛡️</span>
                    <h4 class="font-extrabold text-teal-900 text-sm">হেভেন ক্লিনিক্যাল প্র্যাকটিশনার গ্যারান্টি</h4>
                </div>
                <p class="text-xs text-teal-800/90 leading-relaxed">
                    আপনার BMDC/BCPS ভেরিফায়েড প্রোফাইলটি সম্পূর্ণ এনক্রিপ্টেড এবং হেভেনের ১০০% গোপনীয়তা নীতির আওতাভুক্ত। সেশন চলাকালীন রোগীদের কোনো ব্যক্তিগত পরিচয় প্রকাশ করা বাধ্যতামূলক নয়।
                </p>
            </div>
        </div>

    </div>

</div>
