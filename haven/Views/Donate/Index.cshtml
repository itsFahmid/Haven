@model Haven.Models.PaymentViewModel
@{
    ViewData["Title"] = "মাইক্রো-অনুদান ও হল অফ ফেম | Donate & Hall of Fame";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold uppercase tracking-wider">
            Safe Youth Community Fund
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900" data-bn="তারুণ্যের পাশে দাঁড়ান: ক্ষুদ্র অনুদান তহবিল" data-en="Support Vulnerable Youth: Micro-Donation Fund">
            তারুণ্যের পাশে দাঁড়ান: ক্ষুদ্র অনুদান তহবিল
        </h1>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed" data-bn="আপনার ৳৫০ বা ৳১০০ অনুদানে পরিচালিত হয় বাংলাদেশের সংকটগ্রস্ত তরুণদের জন্য চব্বিশ ঘণ্টার ফ্রি এআই হটলাইন ও সাইবার আইনি সুরক্ষা সেল।" data-en="Every ৳50 or ৳100 keeps HAVEN completely free, encrypted, and accessible for young people dealing with cyber harassment and crisis.">
            আপনার ৳৫০ বা ৳১০০ অনুদানে পরিচালিত হয় বাংলাদেশের সংকটগ্রস্ত তরুণদের জন্য চব্বিশ ঘণ্টার ফ্রি এআই হটলাইন ও সাইবার আইনি সুরক্ষা সেল।
        </p>
    </div>

    <!-- Quick Donation Launch Card -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-lg text-center space-y-6 max-w-xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-3xl mx-auto">
            💝
        </div>

        <div>
            <h3 class="text-xl font-bold text-slate-900" data-bn="তাৎক্ষণিক অনুদান প্রদান করুন" data-en="Make an Instant Contribution">
                তাৎক্ষণিক অনুদান প্রদান করুন
            </h3>
            <p class="text-xs text-slate-500 mt-1" data-bn="বিকাশ, নগদ, রকেট বা যেকোনো ব্যাংক কার্ডের মাধ্যমে" data-en="Via bKash, Nagad, Rocket, or Any Card">
                বিকাশ, নগদ, রকেট বা যেকোনো ব্যাংক কার্ডের মাধ্যমে
            </p>
        </div>

        <button onclick="openModal('paymentModal')" class="w-full py-4 bg-teal-700 hover:bg-teal-800 text-white font-bold text-base rounded-2xl shadow-xl shadow-teal-900/10 transition" data-bn="অনুদানের পপআপ খুলুন ➔" data-en="Open Donation Checkout ➔">
            অনুদানের পপআপ খুলুন ➔
        </button>
    </div>

    <!-- Hall of Fame Full Listing -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-bold text-slate-900" data-bn="হেভেন হল অফ ফেম (সম্মানিত দাতা তালিকা)" data-en="Haven Hall of Fame (Recognized Benefactors)">
                    হেভেন হল অফ ফেম (সম্মানিত দাতা তালিকা)
                </h3>
                <p class="text-xs text-slate-500" data-bn="যারা পরিচয় প্রকাশ করে তরুণদের উৎসাহ দিয়েছেন" data-en="Supporters inspiring youth protection">
                    যারা পরিচয় প্রকাশ করে তরুণদের উৎসাহ দিয়েছেন
                </p>
            </div>
            <span class="text-xs font-bold text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-100">
                ⭐ Community Angels
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            @foreach (var donor in Model.RecentDonors)
            {
                <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/50 hover:bg-white transition flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-sm">
                            ⭐
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-900">@donor.Name</div>
                            <div class="text-[10px] text-slate-400">@donor.City • <span data-bn="@donor.TimeAgoBn" data-en="@donor.TimeAgoEn">@donor.TimeAgoBn</span></div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-xs font-black text-teal-800">৳@donor.AmountBDT</div>
                        <span class="text-[9px] font-bold text-teal-700 bg-teal-50 px-1.5 py-0.5 rounded border border-teal-100" data-bn="@donor.BadgeBn" data-en="@donor.BadgeEn">
                            @donor.BadgeBn
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
