@model Haven.Models.PaymentViewModel
@{
    ViewData["Title"] = "মাইক্রো-অনুদান ও হল অফ ফেম | Donate & Hall of Fame";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="px-3 py-1 bg-amber-100 text-amber-900 rounded-full text-xs font-bold uppercase tracking-wider">
            Safe Youth Community Fund
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight" data-bn="তারুণ্যের পাশে দাঁড়ান: ক্ষুদ্র অনুদান তহবিল" data-en="Support Vulnerable Youth: Micro-Donation Fund">
            তারুণ্যের পাশে দাঁড়ান: ক্ষুদ্র অনুদান তহবিল
        </h1>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed" data-bn="আপনার ৳৫০ বা ৳১০০ অনুদানে পরিচালিত হয় বাংলাদেশের সংকটগ্রস্ত তরুণদের জন্য চব্বিশ ঘণ্টার ফ্রি এআই হটলাইন ও সাইবার আইনি সুরক্ষা সেল।" data-en="Every ৳50 or ৳100 keeps HAVEN completely free, encrypted, and accessible for young people dealing with cyber harassment and crisis.">
            আপনার ৳৫০ বা ৳১০০ অনুদানে পরিচালিত হয় বাংলাদেশের সংকটগ্রস্ত তরুণদের জন্য চব্বিশ ঘণ্টার ফ্রি এআই হটলাইন ও সাইবার আইনি সুরক্ষা সেল।
        </p>
    </div>

    <!-- Quick Donation Launch Card -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm text-center space-y-6 max-w-xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-teal-50 text-teal-700 flex items-center justify-center mx-auto border border-teal-100">
            <svg class="w-8 h-8 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
        </div>

        <div>
            <h3 class="text-xl font-bold text-slate-900" data-bn="তাৎক্ষণিক অনুদান প্রদান করুন" data-en="Make an Instant Contribution">
                তাৎক্ষণিক অনুদান প্রদান করুন
            </h3>
            <p class="text-xs text-slate-500 mt-1" data-bn="বিকাশ, নগদ, রকেট বা যেকোনো ব্যাংক কার্ডের মাধ্যমে" data-en="Via bKash, Nagad, Rocket, or Any Card">
                বিকাশ, নগদ, রকেট বা যেকোনো ব্যাংক কার্ডের মাধ্যমে
            </p>
        </div>

        <button onclick="openModal('paymentModal')" class="w-full py-4 bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm rounded-2xl shadow-sm transition" data-bn="অনুদানের পপআপ খুলুন ➔" data-en="Open Donation Checkout ➔">
            অনুদানের পপআপ খুলুন ➔
        </button>
    </div>

    <!-- Hall of Fame Full Listing -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-bold text-slate-900" data-bn="হেভেন হল অফ ফেম (সম্মানিত দাতা তালিকা)" data-en="Haven Hall of Fame (Recognized Benefactors)">
                    হেভেন হল অফ ফেম (সম্মানিত দাতা তালিকা)
                </h3>
                <p class="text-xs text-slate-500" data-bn="যারা পরিচয় প্রকাশ করে তরুণদের উৎসাহ দিয়েছেন" data-en="Supporters inspiring youth protection">
                    যারা পরিচয় প্রকাশ করে তরুণদের উৎসাহ দিয়েছেন
                </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-100">
                <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span>Community Angels</span>
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            @foreach (var donor in Model.RecentDonors)
            {
                <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white transition flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-sm shrink-0 border border-amber-100">
                            <svg class="w-4 h-4 text-amber-600 fill-amber-500" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-900">@donor.Name</div>
                            <div class="text-[10px] text-slate-500">@donor.City • <span data-bn="@donor.TimeAgoBn" data-en="@donor.TimeAgoEn">@donor.TimeAgoBn</span></div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-xs font-black text-teal-800">৳@donor.AmountBDT</div>
                        <span class="text-[9px] font-bold text-teal-700 bg-teal-50 px-1.5 py-0.5 rounded border border-teal-100" data-bn="@donor.BadgeBn" data-en="@donor.BadgeEn">
                            @donor.BadgeBn
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
