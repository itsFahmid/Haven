@model Obhoy.Models.PaymentViewModel
@{
    ViewData["Title"] = "টেকসই তহবিল ও মানসিক স্বাস্থ্যসেবা ভর্তুকি | Sanctuary Stewardship & Care Fund";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    
    <!-- Hero / Purpose Section -->
    <header class="max-w-3xl mx-auto text-center space-y-4">
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-[1.2]" data-bn="উন্মুক্ত ও গোপনীয় ডিজিটাল নিরাপত্তা সবার জন্য বজায় রাখা" data-en="Sustaining Free, Encrypted Mental Health & Safety for Bangladesh">
            উন্মুক্ত ও গোপনীয় ডিজিটাল নিরাপত্তা সবার জন্য বজায় রাখা
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto" data-bn="অভয় কোনো বাণিজ্যিক বা অনুদান-নির্ভর এনজিও সংস্থা নয়। এটি একটি উন্মুক্ত, জিরো-ট্র্যাকিং ডিজিটাল সংকট প্রতিরোধ প্রযুক্তি। আপনার স্বেচ্ছাসেবী সহযোগিতা সার্ভার হোস্টিং, এআই হটলাইন কম্পিউট এবং অস্বচ্ছল তরুণদের ভেরিফায়েড থেরাপিস্টদের ফি ভর্তুকি দিতে ব্যবহৃত হয়।" data-en="OBHOY is not a commercial enterprise or traditional charity. It is a zero-tracking digital safety sanctuary. Community stewardship directly funds cloud uptime, AI crisis triage compute, and clinician subsidies for youth who cannot afford private therapy.">
            অভয় কোনো বাণিজ্যিক বা অনুদান-নির্ভর এনজিও সংস্থা নয়। এটি একটি উন্মুক্ত, জিরো-ট্র্যাকিং ডিজিটাল সংকট প্রতিরোধ প্রযুক্তি। আপনার স্বেচ্ছাসেবী সহযোগিতা সার্ভার হোস্টিং, এআই হটলাইন কম্পিউট এবং অস্বচ্ছল তরুণদের ভেরিফায়েড থেরাপিস্টদের ফি ভর্তুকি দিতে ব্যবহৃত হয়।
        </p>
    </header>

    <!-- Anonymous Aggregate Telemetry (No Names, No Rankings) -->
    <section aria-label="Community Care Telemetry" class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs text-center space-y-1 transition hover:-translate-y-1 duration-200">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block" data-bn="মোট যত্ন তহবিল" data-en="Community Care Pool">
                মোট যত্ন তহবিল
            </span>
            <div class="text-2xl sm:text-3xl font-black text-teal-800">
                ৳@Model.TotalSponsoredPoolBDT.ToString("N0")
            </div>
            <span class="text-xs text-slate-400 block" data-bn="সম্পূর্ণ স্বচ্ছ তহবিল" data-en="Directly Allocated">সম্পূর্ণ স্বচ্ছ তহবিল</span>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs text-center space-y-1 transition hover:-translate-y-1 duration-200">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block" data-bn="ভর্তুকিপ্রাপ্ত সেশন" data-en="Subsidized Sessions">
                ভর্তুকিপ্রাপ্ত সেশন
            </span>
            <div class="text-2xl sm:text-3xl font-black text-teal-800">
                @Model.SubsidizedSessionsCount টি
            </div>
            <span class="text-xs text-slate-400 block" data-bn="BMDC ভেরিফায়েড থেরাপি" data-en="Verified Clinical Care">BMDC ভেরিফায়েড থেরাপি</span>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs text-center space-y-1 transition hover:-translate-y-1 duration-200">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block" data-bn="সার্বক্ষণিক হটলাইন আপটাইম" data-en="Helpline Availability">
                সার্বক্ষণিক হটলাইন আপটাইম
            </span>
            <div class="text-2xl sm:text-3xl font-black text-teal-800">
                ২৪/৭
            </div>
            <span class="text-xs text-slate-400 block" data-bn="জরুরি সংকট এআই ও রুট" data-en="AI Triage & 1098 Routing">জরুরি সংকট এআই ও রুট</span>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs text-center space-y-1 transition hover:-translate-y-1 duration-200">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block" data-bn="আর্থিক গোপনীয়তা" data-en="Financial Privacy">
                আর্থিক গোপনীয়তা
            </span>
            <div class="text-2xl sm:text-3xl font-black text-emerald-700">
                ১০০%
            </div>
            <span class="text-xs text-slate-400 block" data-bn="জিরো-লগিং অডিট শিল্ড" data-en="Zero Log Retention">জিরো-লগিং অডিট শিল্ড</span>
        </div>
    </section>

    <!-- Main Contribution & Impact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left 7 Cols: Three Transparency Pillars -->
        <section class="lg:col-span-7 space-y-6">
            <div>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight" data-bn="আপনার অবদানের সুনির্দিষ্ট ব্যবহার" data-en="Where Every Taka Goes">
                    আপনার অবদানের সুনির্দিষ্ট ব্যবহার
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1" data-bn="আমরা বাণিজ্যিক বিজ্ঞাপন প্রদর্শন করি না এবং কোনো ব্যবহারকারীর তথ্য বিক্রি করি না।" data-en="We never display third-party advertisements or sell user information.">
                    আমরা বাণিজ্যিক বিজ্ঞাপন প্রদর্শন করি না এবং কোনো ব্যবহারকারীর তথ্য বিক্রি করি না।
                </p>
            </div>

            <!-- Pillar 1: Subsidized Care -->
            <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-2xs flex items-start gap-5 transition hover:shadow-md duration-200">
                <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 border border-teal-100">
                    <svg class="w-6 h-6 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-bold text-slate-900" data-bn="প্রান্তিক তরুণদের জন্য পূর্ণ থেরাপি সেশন ভর্তুকি" data-en="Clinical Therapy Subsidies for Vulnerable Youth">
                        প্রান্তিক তরুণদের জন্য পূর্ণ থেরাপি সেশন ভর্তুকি
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" data-bn="বাংলাদেশে পেশাদার মানসিক স্বাস্থ্যসেবা অনেকের জন্যই ব্যয়বহুল। অস্বচ্ছল তরুণ ও অভিভাবকরা যাতে বিনামূল্যে বা নামমাত্র মূল্যে BMDC-ভেরিফায়েড সাইকিয়াট্রিস্ট ও সাইকোলজিস্টদের সাথে কাউন্সেলিং পেতে পারেন, তহবিলের একটি বড় অংশ সরাসরি সেই চিকিৎসকদের ফি পরিশোধে ব্যবহৃত হয়।" data-en="Professional psychiatric and psychological care is cost-prohibitive for many. Community funds directly reimburse licensed BMDC clinicians when disadvantaged adolescents or parents request subsidized care.">
                        বাংলাদেশে পেশাদার মানসিক স্বাস্থ্যসেবা অনেকের জন্যই ব্যয়বহুল। অস্বচ্ছল তরুণ ও অভিভাবকরা যাতে বিনামূল্যে বা নামমাত্র মূল্যে BMDC-ভেরিফায়েড সাইকিয়াট্রিস্ট ও সাইকোলজিস্টদের সাথে কাউন্সেলিং পেতে পারেন, তহবিলের একটি বড় অংশ সরাসরি সেই চিকিৎসকদের ফি পরিশোধে ব্যবহৃত হয়।
                    </p>
                </div>
            </div>

            <!-- Pillar 2: AI Triage & Emergency Infrastructure -->
            <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-2xs flex items-start gap-5 transition hover:shadow-md duration-200">
                <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 border border-teal-100">
                    <svg class="w-6 h-6 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-bold text-slate-900" data-bn="২৪/৭ এআই ক্রাইসিস ট্রায়াজ ও সার্ভার আপটাইম" data-en="24/7 AI Triage & High-Availability Servers">
                        ২৪/৭ এআই ক্রাইসিস ট্রায়াজ ও সার্ভার আপটাইম
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" data-bn="রাত ৩টায় ব্ল্যাকমেইল বা তীব্র আত্মহত্যার ঝুঁকির মুখে থাকা কিশোরদের প্রথম আশ্রয় হলো আমাদের কৃত্রিম বুদ্ধিমত্তা চালিত জরুরি ট্রায়াজ। এই সার্ভার ও নিরাপদ ক্লাউড ব্যাকএন্ড ২৪ ঘণ্টা অবিরাম সচল রাখতে এআই এপিআই কম্পিউট ও হোস্টিং ব্যয় নিয়মিত পরিচালনা করা আবশ্যক।" data-en="At 3 AM when an adolescent faces blackmail or acute crisis, our automated AI triage provides instant psychological first aid and 1098 routing. Funds cover ongoing AI API tokens and low-latency encrypted hosting.">
                        রাত ৩টায় ব্ল্যাকমেইল বা তীব্র আত্মহত্যার ঝুঁকির মুখে থাকা কিশোরদের প্রথম আশ্রয় হলো আমাদের কৃত্রিম বুদ্ধিমত্তা চালিত জরুরি ট্রায়াজ। এই সার্ভার ও নিরাপদ ক্লাউড ব্যাকএন্ড ২৪ ঘণ্টা অবিরাম সচল রাখতে এআই এপিআই কম্পিউট ও হোস্টিং ব্যয় নিয়মিত পরিচালনা করা আবশ্যক।
                    </p>
                </div>
            </div>

            <!-- Pillar 3: Zero-Data Privacy & Independence -->
            <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-2xs flex items-start gap-5 transition hover:shadow-md duration-200">
                <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 border border-teal-100">
                    <svg class="w-6 h-6 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-bold text-slate-900" data-bn="জিরো-লগিং ও প্রাতিষ্ঠানিক স্বাধীনতা" data-en="Zero-Log Architecture & Complete Independence">
                        জিরো-লগিং ও প্রাতিষ্ঠানিক স্বাধীনতা
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" data-bn="কোনো বাণিজ্যিক স্বার্থের কাছে দায়বদ্ধ না থাকায় অভয় কোনো ব্যবহারকারীর আইপি বা চ্যাট ইতিহাস সংরক্ষণ করে না। স্বতন্ত্র কমিউনিটি অর্থায়ন আমাদের এই নিরঙ্কুশ নিরাপত্তা ও নিরপেক্ষতা ধরে রাখতে সক্ষম করে তোলে।" data-en="Free from corporate advertising incentives, OBHOY operates a zero-activity-retention policy. Community funding preserves our strict neutrality, encryption, and zero-tracking commitment.">
                        কোনো বাণিজ্যিক স্বার্থের কাছে দায়বদ্ধ না থাকায় অভয় কোনো ব্যবহারকারীর আইপি বা চ্যাট ইতিহাস সংরক্ষণ করে না। স্বতন্ত্র কমিউনিটি অর্থায়ন আমাদের এই নিরঙ্কুশ নিরাপত্তা ও নিরপেক্ষতা ধরে রাখতে সক্ষম করে তোলে।
                    </p>
                </div>
            </div>
        </section>

        <!-- Right 5 Cols: Contribution Card -->
        <div class="lg:col-span-5 sticky top-28">
            <div class="bg-white rounded-3xl p-7 sm:p-8 border border-slate-200/90 shadow-lg space-y-6">
                
                <div class="pb-4 border-b border-slate-100 space-y-1">
                    <h2 class="text-xl font-bold text-slate-900" data-bn="সহযোগিতার পরিমাণ নির্ধারণ করুন" data-en="Select Contribution Tier">
                        সহযোগিতার পরিমাণ নির্ধারণ করুন
                    </h2>
                    <p class="text-xs text-slate-500" data-bn="বিকাশ, নগদ, রকেট বা যেকোনো ডেবিট/ক্রেডিট কার্ডের মাধ্যমে" data-en="Via bKash, Nagad, Rocket, or Any Card">
                        বিকাশ, নগদ, রকেট বা যেকোনো ডেবিট/ক্রেডিট কার্ডের মাধ্যমে
                    </p>
                </div>

                <!-- Meaningful Presets Matching Real Costs -->
                <div class="space-y-2.5">
                    
                    <label class="block p-3.5 rounded-2xl border-2 border-slate-200 cursor-pointer transition hover:border-teal-700 bg-white" onclick="ObhoyPayment.setAmount(100, this)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="presetAmount" value="100" class="text-teal-700 focus:ring-teal-600" />
                                <div>
                                    <div class="text-xs font-bold text-slate-900" data-bn="হটলাইন অবকাঠামো সহায়তা" data-en="Helpline Infrastructure">হটলাইন অবকাঠামো সহায়তা</div>
                                    <div class="text-[11px] text-slate-500" data-bn="১ দিনের সার্বিক ট্রায়াজ ও ক্লাউড আপটাইম" data-en="1 Day of Continuous AI & Cloud Uptime">১ দিনের সার্বিক ট্রায়াজ ও ক্লাউড আপটাইম</div>
                                </div>
                            </div>
                            <span class="text-sm font-black text-slate-900">৳১০০</span>
                        </div>
                    </label>

                    <label class="block p-3.5 rounded-2xl border-2 border-slate-200 cursor-pointer transition hover:border-teal-700 bg-white" onclick="ObhoyPayment.setAmount(300, this)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="presetAmount" value="300" class="text-teal-700 focus:ring-teal-600" />
                                <div>
                                    <div class="text-xs font-bold text-slate-900" data-bn="সাইবার ও আইনি সুরক্ষা সংস্থান" data-en="Cyber Safety Resources">সাইবার ও আইনি সুরক্ষা সংস্থান</div>
                                    <div class="text-[11px] text-slate-500" data-bn="ব্ল্যাকমেইল ও বুলিং প্রতিরোধ কনটেন্ট" data-en="Anti-Extortion Education Modules">ব্ল্যাকমেইল ও বুলিং প্রতিরোধ কনটেন্ট</div>
                                </div>
                            </div>
                            <span class="text-sm font-black text-slate-900">৳৩০০</span>
                        </div>
                    </label>

                    <label class="block p-3.5 rounded-2xl border-2 border-teal-700 cursor-pointer transition bg-teal-50/40" onclick="ObhoyPayment.setAmount(600, this)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="presetAmount" value="600" checked class="text-teal-700 focus:ring-teal-600" />
                                <div>
                                    <div class="text-xs font-bold text-teal-900 flex items-center gap-1.5">
                                        <span data-bn="১ জন তরুণের পূর্ণ থেরাপি সেশন" data-en="Sponsor 1 Full Clinical Therapy Session">১ জন তরুণের পূর্ণ থেরাপি সেশন</span>
                                        <span class="px-1.5 py-0.5 rounded bg-teal-700 text-white text-[9px] font-bold uppercase">Standard</span>
                                    </div>
                                    <div class="text-[11px] text-teal-700" data-bn="ভেরিফায়েড ক্লিনিক্যাল সেশনের সম্পূর্ণ ফি" data-en="Full Fee for 1 Verified Clinician Session">ভেরিফায়েড ক্লিনিক্যাল সেশনের সম্পূর্ণ ফি</div>
                                </div>
                            </div>
                            <span class="text-sm font-black text-teal-900">৳৬০০</span>
                        </div>
                    </label>

                    <label class="block p-3.5 rounded-2xl border-2 border-slate-200 cursor-pointer transition hover:border-teal-700 bg-white" onclick="ObhoyPayment.setAmount(1200, this)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="presetAmount" value="1200" class="text-teal-700 focus:ring-teal-600" />
                                <div>
                                    <div class="text-xs font-bold text-slate-900" data-bn="দ্বৈত ক্লিনিক্যাল কাউন্সেলিং ভর্তুকি" data-en="Double Clinical Session Subsidy">দ্বৈত ক্লিনিক্যাল কাউন্সেলিং ভর্তুকি</div>
                                    <div class="text-[11px] text-slate-500" data-bn="২ জন সংকটাপন্ন কিশোর-কিশোরীর সেশন" data-en="Sponsors 2 Complete Psychological Sessions">২ জন সংকটাপন্ন কিশোর-কিশোরীর সেশন</div>
                                </div>
                            </div>
                            <span class="text-sm font-black text-slate-900">৳১,২০০</span>
                        </div>
                    </label>

                </div>

                <!-- Custom Amount Input -->
                <div class="space-y-1.5">
                    <label for="customAmountInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider" data-bn="অন্যান্য যেকোনো পরিমাণ (ন্যূনতম ৳১০)" data-en="Custom Amount in BDT (Min ৳10)">
                        অন্যান্য যেকোনো পরিমাণ (ন্যূনতম ৳১০)
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 font-bold text-sm">৳</span>
                        <input type="number" id="customAmountInput" value="600" min="10" step="10" placeholder="Custom Amount in BDT" class="w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600 font-bold text-slate-900" />
                    </div>
                </div>

                <!-- Optional Hall of Fame Recognition -->
                <div class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-4 space-y-3 text-xs">
                    <label class="flex items-start gap-2.5 cursor-pointer select-none">
                        <input type="checkbox" id="optHallOfFameCheck" onchange="document.getElementById('donateHallOfFameFields').classList.toggle('hidden', !this.checked)" class="mt-0.5 w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-amber-300" />
                        <div>
                            <span class="font-bold text-amber-950 text-xs block" data-bn="অভয় অভিভাবক হল অফ ফেমে আমার নাম যুক্ত করুন" data-en="Add my name to Sanctuary Hall of Fame">
                                অভয় অভিভাবক হল অফ ফেমে আমার নাম যুক্ত করুন
                            </span>
                            <span class="text-[11px] text-amber-800/80 block mt-0.5" data-bn="অ্যাডমিন পর্যালোচনার পর আপনার অবদান নিচের পাবলিক তালিকায় স্থান পাবে" data-en="Your contribution will be recognized publicly following admin review">
                                অ্যাডমিন পর্যালোচনার পর আপনার অবদান নিচের পাবলিক তালিকায় স্থান পাবে
                            </span>
                        </div>
                    </label>

                    <div id="donateHallOfFameFields" class="hidden space-y-2.5 pt-2 border-t border-amber-200/60">
                        <div>
                            <label class="block text-[11px] font-semibold text-amber-900 mb-1" data-bn="প্রদর্শন নাম / ছদ্মনাম" data-en="Public Display Name / Alias">
                                প্রদর্শন নাম / ছদ্মনাম
                            </label>
                            <input type="text" id="donorDisplayNameInput" placeholder="e.g. Farhan Chowdhury / শুভাকাঙ্ক্ষী" class="w-full px-3 py-2 bg-white border border-amber-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-amber-900 mb-1" data-bn="উৎসাহমূলক বার্তা (ঐচ্ছিক)" data-en="Encouraging Note (Optional)">
                                উৎসাহমূলক বার্তা (ঐচ্ছিক)
                            </label>
                            <input type="text" id="donorRecognitionMessageInput" placeholder="e.g. পাশে আছি সব সময় / Supporting young lives" class="w-full px-3 py-2 bg-white border border-amber-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                        </div>
                    </div>
                </div>

                <!-- Direct SSLCommerz Initiation Button -->
                <div class="space-y-3 pt-2">
                    <button type="button" id="confirmPaymentBtn" onclick="ObhoyPayment.processPayment()" class="w-full py-4 px-6 bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm rounded-2xl shadow-sm transition flex items-center justify-center gap-2">
                        <span data-bn="নিরাপদ গেটওয়েতে এগিয়ে যান (SSLCommerz) ➔" data-en="Proceed to Secure Checkout (SSLCommerz) ➔">
                            নিরাপদ গেটওয়েতে এগিয়ে যান (SSLCommerz) ➔
                        </span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </button>

                    <div class="flex items-center justify-center gap-2 text-[11px] text-slate-500">
                        <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span data-bn="256-Bit SSL এনক্রিপ্টেড • কোনো কার্ড তথ্য অভয়ে সংরক্ষিত হয় না" data-en="256-Bit SSL Encrypted • Zero Cardholder Data Retained">
                            256-Bit SSL এনক্রিপ্টেড • কোনো কার্ড তথ্য অভয়ে সংরক্ষিত হয় না
                        </span>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Section: Sanctuary Guardians Hall of Fame -->
    <section class="space-y-8 pt-8 border-t border-slate-200/80" id="hallOfFame">
        <div class="max-w-3xl mx-auto text-center space-y-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200">
                <svg class="w-3.5 h-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 2a1 1 0 01.78.375l2.25 2.875 3.633.48a1 1 0 01.554 1.705l-2.65 2.583.626 3.619a1 1 0 01-1.451 1.054L10 13.19l-3.242 1.496a1 1 0 01-1.451-1.054l.626-3.62-2.65-2.582a1 1 0 01.554-1.705l3.633-.48 2.25-2.875A1 1 0 0110 2z" clip-rule="evenodd" />
                </svg>
                <span data-bn="স্বীকৃত অভিভাবকবৃন্দ" data-en="Recognized Sanctuary Guardians">স্বীকৃত অভিভাবকবৃন্দ</span>
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight" data-bn="অভয় অভিভাবক হল অফ ফেম" data-en="Sanctuary Guardians Hall of Fame">
                অভয় অভিভাবক হল অফ ফেম
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed" data-bn="যেসব সহৃদয় দাতা নিজেদের নাম প্রকাশ করে বাংলাদেশের তরুণদের মানসিক স্বাস্থ্য ও সাইবার সুরক্ষায় পাশে দাঁড়িয়েছেন। সকল নাম অ্যাডমিন দ্বারা যাচাই ও অনুমোদিত।" data-en="Honoring community members who chose to stand with Bangladesh youth by publicly sponsoring mental healthcare and crisis infrastructure. All listings are verified and approved by sanctuary administrators.">
                যেসব সহৃদয় দাতা নিজেদের নাম প্রকাশ করে বাংলাদেশের তরুণদের মানসিক স্বাস্থ্য ও সাইবার সুরক্ষায় পাশে দাঁড়িয়েছেন। সকল নাম অ্যাডমিন দ্বারা যাচাই ও অনুমোদিত।
            </p>
        </div>

        @if (!Model.HallOfFameDonors.Any())
        {
            <div class="bg-white rounded-3xl p-10 sm:p-12 border border-slate-200/90 shadow-2xs text-center max-w-2xl mx-auto space-y-4">
                <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center mx-auto border border-amber-200/80">
                    <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 21l-8.228-8.228a6 6 0 118.486-8.486L12 4.028l.742-.742a6 6 0 118.486 8.486L12 21z" />
                    </svg>
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-black text-slate-900" data-bn="প্রথম পাবলিক অভিভাবক হিসেবে যুক্ত হোন" data-en="Be Among Our First Recognized Guardians">
                        প্রথম পাবলিক অভিভাবক হিসেবে যুক্ত হোন
                    </h3>
                    <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed" data-bn="অনুদানের সময় 'হল অফ ফেমে নাম যুক্ত করুন' নির্বাচন করলে অ্যাডমিন পর্যালোচনার পর আপনার নাম ও অনুপ্রেরণামূলক বার্তা এখানে সম্মানের সাথে প্রদর্শিত হবে।" data-en="Select 'Add my name to Hall of Fame' during contribution. Following administrator safety review, your name and uplifting message will be recognized here.">
                        অনুদানের সময় 'হল অফ ফেমে নাম যুক্ত করুন' নির্বাচন করলে অ্যাডমিন পর্যালোচনার পর আপনার নাম ও অনুপ্রেরণামূলক বার্তা এখানে সম্মানের সাথে প্রদর্শিত হবে।
                    </p>
                </div>
                <button type="button" onclick="document.getElementById('customAmountInput').focus()" class="px-5 py-2.5 bg-teal-50 hover:bg-teal-100 text-teal-800 font-bold text-xs rounded-xl border border-teal-200 transition">
                    <span data-bn="উপরে অনুদান ফর্মে যান ➔" data-en="Go to Contribution Form ➔">উপরে অনুদান ফর্মে যান ➔</span>
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                @foreach (var donor in Model.HallOfFameDonors)
                {
                    <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-teal-800 via-teal-700 to-amber-700 text-white font-black text-sm flex items-center justify-center shadow-xs">
                                        @(string.IsNullOrWhiteSpace(donor.Name) ? "G" : donor.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-black text-slate-900 truncate">@donor.Name</h4>
                                        <span class="text-[11px] text-slate-400">@donor.City • @donor.TimeAgoBn</span>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 bg-amber-50 text-amber-900 border border-amber-200 rounded-xl text-xs font-black shrink-0">
                                    ৳@donor.AmountBDT.ToString("N0")
                                </span>
                            </div>

                            <div class="flex items-center gap-1.5">
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200" data-bn="@donor.BadgeBn" data-en="@donor.BadgeEn">
                                    <svg class="w-2.5 h-2.5 text-teal-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                    <span>@donor.BadgeBn</span>
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(donor.Message))
                            {
                                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 italic leading-relaxed">
                                    "@donor.Message"
                                </div>
                            }
                        </div>

                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                            <span>BMDC থেরাপি সেবা ভর্তুকি</span>
                            <span class="text-emerald-700 font-bold flex items-center gap-1">
                                <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                ভেরিফায়েড
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>
