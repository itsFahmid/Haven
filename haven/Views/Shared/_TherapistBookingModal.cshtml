@model Haven.Models.BookingCreateModel
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div id="bookingModal" class="haven-modal fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/80 backdrop-blur-sm overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle">
    <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all my-8">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 p-6 text-white relative">
            <button type="button" onclick="closeBookingModal()" class="absolute top-5 right-5 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-2 rounded-full transition" aria-label="Close modal">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-extrabold uppercase tracking-wider mb-2">
                <span>✓ BMDC Verified Specialist Session</span>
            </div>
            <h3 id="bookingModalTitle" class="text-xl font-bold text-white">গোপনীয় অ্যাপয়েন্টমেন্ট বুকিং</h3>
            <p id="modalTherapistSubtitle" class="text-xs text-teal-200 mt-1 font-medium">Therapist: Loading...</p>
        </div>

        @if (!isAuthenticated)
        {
            <div class="p-8 text-center space-y-4">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mx-auto text-2xl">
                    🔒
                </div>
                <h4 class="text-base font-bold text-slate-900">লগইন প্রয়োজন / Login Required</h4>
                <p class="text-xs text-slate-600 leading-relaxed max-w-sm mx-auto">
                    থেরাপিস্টের সাথে নিরাপদ ও গোপনীয় অ্যাপয়েন্টমেন্ট নিশ্চিত করতে অনুগ্রহ করে আপনার অ্যাকাউন্টে লগইন বা সাইন আপ করুন।
                </p>
                <div class="flex items-center justify-center gap-3 pt-2">
                    <a asp-controller="Account" asp-action="Login" class="px-5 py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl transition shadow-md">
                        লগইন করুন ➔
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition">
                        নতুন একাউন্ট খুলুন
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Booking Form -->
            <form asp-controller="Booking" asp-action="Create" method="post" class="p-6 md:p-8 space-y-5" id="appointmentBookingForm">
                @Html.AntiForgeryToken()
                
                <input type="hidden" name="TherapistId" id="modalTherapistId" value="" />
                <input type="hidden" name="ReturnUrl" id="modalReturnUrl" value="" />

                <!-- Date Picker -->
                <div>
                    <label for="modalBookingDate" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        📅 অ্যাপয়েন্টমেন্টের তারিখ নির্বাচন করুন / Select Date <span class="text-rose-500">*</span>
                    </label>
                    <input type="date" id="modalBookingDate" name="BookingDate" required
                           min="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                           value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd")"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-teal-600 focus:bg-white focus:outline-none transition" />
                </div>

                <!-- Time Slot Picker -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        ⏰ সময় স্লট নির্বাচন করুন / Select Time Slot <span class="text-rose-500">*</span>
                    </label>
                    <input type="hidden" name="TimeSlot" id="modalSelectedTimeSlot" value="04:30 PM - 05:30 PM" required />
                    
                    <div class="grid grid-cols-2 gap-2" id="slotButtonsContainer">
                        <button type="button" onclick="selectBookingSlot('11:00 AM - 12:00 PM', this)" class="slot-opt-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                            <span class="block font-bold">সকাল (Morning)</span>
                            <span class="text-[11px] text-slate-500">11:00 AM - 12:00 PM</span>
                        </button>
                        <button type="button" onclick="selectBookingSlot('04:30 PM - 05:30 PM', this)" class="slot-opt-btn py-2.5 px-3 rounded-xl border-2 border-teal-700 bg-teal-50 text-teal-900 font-semibold text-xs text-left transition">
                            <span class="block font-bold">বিকাল (Afternoon)</span>
                            <span class="text-[11px] text-teal-700 font-bold">04:30 PM - 05:30 PM</span>
                        </button>
                        <button type="button" onclick="selectBookingSlot('07:00 PM - 08:00 PM', this)" class="slot-opt-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                            <span class="block font-bold">সন্ধ্যা (Evening)</span>
                            <span class="text-[11px] text-slate-500">07:00 PM - 08:00 PM</span>
                        </button>
                        <button type="button" onclick="selectBookingSlot('09:00 PM - 10:00 PM', this)" class="slot-opt-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition">
                            <span class="block font-bold">রাত (Night)</span>
                            <span class="text-[11px] text-slate-500">09:00 PM - 10:00 PM</span>
                        </button>
                    </div>
                </div>

                <!-- Communication Mode -->
                <div>
                    <label for="modalCommMode" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        🔒 সেশন যোগাযোগের মাধ্যম / Session Mode
                    </label>
                    <select id="modalCommMode" name="CommunicationMode" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-teal-600 focus:bg-white focus:outline-none transition">
                        <option value="Online Video">গোপনীয় ভিডিও কল (End-to-End Encrypted Video)</option>
                        <option value="Confidential Audio">গোপনীয় অডিও কল (Voice Only)</option>
                        <option value="In-Person">সরাসরি চেম্বারে (In-Person Clinic Visit)</option>
                    </select>
                </div>

                <!-- Notes / Concerns (Optional) -->
                <div>
                    <label for="modalNotes" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        📝 আপনার সমস্যা বা নোট (ঐচ্ছিক / Optional Notes)
                    </label>
                    <textarea id="modalNotes" name="Notes" rows="2" placeholder="আপনি কি বিষয়ে আলোচনা করতে চান বা কোনো বিশেষ প্রয়োজন থাকলে লিখুন..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:bg-white focus:outline-none transition"></textarea>
                </div>

                <!-- Fee / Subsidy Info Card -->
                <div class="p-3.5 bg-teal-50/80 border border-teal-200 rounded-2xl flex items-center justify-between gap-3">
                    <div>
                        <span class="text-[10px] uppercase tracking-wider font-bold text-teal-800 block">পরামর্শ ফি (Session Fee)</span>
                        <span id="modalFeeDisplay" class="text-base font-black text-slate-900">৳0</span>
                    </div>
                    <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-teal-900 bg-white px-3 py-1.5 rounded-xl border border-teal-200 shadow-xs">
                        <input type="checkbox" name="RequestFeeSubsidy" value="true" class="rounded text-teal-700 focus:ring-teal-600" />
                        <span>ফ্রি স্কলারশিপ আবেদন</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full py-3.5 bg-teal-700 hover:bg-teal-800 active:scale-[0.99] text-white font-bold text-sm rounded-xl transition shadow-lg shadow-teal-900/15 flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>অ্যাপয়েন্টমেন্ট নিশ্চিত করুন (Submit Request)</span>
                </button>

            </form>
        }

    </div>
</div>

<script>
    function openBookingModal(therapistId, therapistNameEn, therapistNameBn, hourlyRate) {
        var modal = document.getElementById('bookingModal');
        if (!modal) return;

        var idInput = document.getElementById('modalTherapistId');
        var subtitle = document.getElementById('modalTherapistSubtitle');
        var feeDisplay = document.getElementById('modalFeeDisplay');
        var returnUrlInput = document.getElementById('modalReturnUrl');

        if (idInput) idInput.value = therapistId;
        if (subtitle) subtitle.innerText = "Therapist: " + (therapistNameBn || therapistNameEn);
        if (feeDisplay) feeDisplay.innerText = "৳" + (hourlyRate || 500);
        if (returnUrlInput) returnUrlInput.value = window.location.pathname;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeBookingModal() {
        var modal = document.getElementById('bookingModal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    function selectBookingSlot(slotTime, btnElement) {
        var timeInput = document.getElementById('modalSelectedTimeSlot');
        if (timeInput) timeInput.value = slotTime;

        var container = document.getElementById('slotButtonsContainer');
        if (container) {
            var btns = container.querySelectorAll('.slot-opt-btn');
            btns.forEach(function (b) {
                b.className = "slot-opt-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs text-left hover:border-teal-500 transition";
            });
        }

        if (btnElement) {
            btnElement.className = "slot-opt-btn py-2.5 px-3 rounded-xl border-2 border-teal-700 bg-teal-50 text-teal-900 font-semibold text-xs text-left transition";
        }
    }
</script>
