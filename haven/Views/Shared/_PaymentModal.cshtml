                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900" data-bn="টেকসই তহবিল ও মানসিক স্বাস্থ্যসেবা ভর্তুকি" data-en="Sanctuary Stewardship & Care Fund">
                            টেকসই তহবিল ও মানসিক স্বাস্থ্যসেবা ভর্তুকি
                        </h3>
                        <p class="text-xs text-slate-500" data-bn="সার্বক্ষণিক গোপনীয় সংকট হটলাইন ও কাউন্সেলিং সেবা সচল রাখুন" data-en="Sustaining 24/7 confidential crisis recovery & clinical subsidies">
                            সার্বক্ষণিক গোপনীয় সংকট হটলাইন ও কাউন্সেলিং সেবা সচল রাখুন
                        </p>
                    </div>
                </div>
                <button onclick="closeModal('paymentModal')" class="text-slate-400 hover:text-slate-700 p-2 rounded-full hover:bg-slate-100 transition" aria-label="Close">
                    ✕
                </button>
            </div>

            <!-- Amount Presets Matching Real Sanctuary Costs -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5" data-bn="সহযোগিতার পরিমাণ নির্বাচন করুন" data-en="Select Contribution Tier">
                    সহযোগিতার পরিমাণ নির্বাচন করুন
                </label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <button type="button" onclick="ObhoyPayment.setAmount(100, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-xs sm:text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳১০০
                    </button>
                    <button type="button" onclick="ObhoyPayment.setAmount(300, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-xs sm:text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳৩০০
                    </button>
                    <button type="button" onclick="ObhoyPayment.setAmount(600, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-teal-700 text-center font-semibold text-xs sm:text-sm transition bg-teal-700 text-white">
                        ৳৬০০ <span class="text-[9px] block font-normal opacity-90">১ সেশন</span>
                    </button>
                    <button type="button" onclick="ObhoyPayment.setAmount(1200, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-xs sm:text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳১,২০০ <span class="text-[9px] block font-normal opacity-90">২ সেশন</span>
                    </button>
                </div>
                
                <div class="mt-3 relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-sm">৳</span>
                    <input type="number" id="customAmountInput" value="600" min="10" placeholder="Custom Amount in BDT" class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600 font-bold text-slate-900" />
                </div>
            </div>

            <!-- Supported Gateway Channels -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2" data-bn="অনুমোদিত পেমেন্ট চ্যানেল (SSLCommerz)" data-en="Supported Payment Channels (SSLCommerz)">
                    অনুমোদিত পেমেন্ট চ্যানেল (SSLCommerz)
                </label>
                <div class="grid grid-cols-4 gap-2 text-center text-xs">
                    <div class="p-2.5 rounded-xl border border-slate-200 bg-slate-50/60 font-semibold text-slate-700 flex flex-col items-center justify-center">
                        <span class="w-6 h-6 rounded-full bg-[#e2136e] text-white flex items-center justify-center text-[10px] font-bold mb-1">bK</span>
                        <span class="text-[11px]">bKash</span>
                    </div>
                    <div class="p-2.5 rounded-xl border border-slate-200 bg-slate-50/60 font-semibold text-slate-700 flex flex-col items-center justify-center">
                        <span class="w-6 h-6 rounded-full bg-[#f7941d] text-white flex items-center justify-center text-[10px] font-bold mb-1">ন</span>
                        <span class="text-[11px]">Nagad</span>
                    </div>
                    <div class="p-2.5 rounded-xl border border-slate-200 bg-slate-50/60 font-semibold text-slate-700 flex flex-col items-center justify-center">
                        <span class="w-6 h-6 rounded-full bg-[#8c3494] text-white flex items-center justify-center text-[10px] font-bold mb-1">R</span>
                        <span class="text-[11px]">Rocket</span>
                    </div>
                    <div class="p-2.5 rounded-xl border border-slate-200 bg-slate-50/60 font-semibold text-slate-700 flex flex-col items-center justify-center">
                        <span class="w-6 h-6 rounded-full bg-slate-800 text-white flex items-center justify-center text-[10px] font-bold mb-1">💳</span>
                        <span class="text-[11px]">Any Card</span>
                    </div>
                </div>
            </div>

            <!-- Zero-Tracking Privacy Shield Guarantee -->
            <div class="bg-teal-50/60 border border-teal-100 rounded-2xl p-3.5 space-y-1 text-xs">
                <div class="font-bold text-teal-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    <span data-bn="সম্পূর্ণ গোপনীয় ও বেনামী লেনদেন সুরক্ষা" data-en="100% Confidential & Anonymous Stewardship">
                        সম্পূর্ণ গোপনীয় ও বেনামী লেনদেন সুরক্ষা
                    </span>
                </div>
                <p class="text-[11px] text-teal-800 leading-relaxed" data-bn="অভয় কোনো ব্যক্তিগত পরিচয় সংরক্ষণ করে না। লেনদেনটি SSLCommerz এর 256-Bit SSL এনক্রিপ্টেড ব্যাংক গেটওয়েতে সম্পূর্ণ নিরাপদে সম্পন্ন হবে।" data-en="Zero sensitive identity retention per the Obhoy Privacy Shield. Transactions are executed directly within SSLCommerz 256-bit banking gateways.">
                    অভয় কোনো ব্যক্তিগত পরিচয় সংরক্ষণ করে না। লেনদেনটি SSLCommerz এর 256-Bit SSL এনক্রিপ্টেড ব্যাংক গেটওয়েতে সম্পূর্ণ নিরাপদে সম্পন্ন হবে।
                </p>
                <input type="checkbox" id="payAnonymousCheck" checked class="hidden" />
            </div>

            <!-- Actions -->
            <div class="pt-2">
                <button type="button" id="confirmPaymentBtn" onclick="ObhoyPayment.processPayment()" class="w-full py-4 px-5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm rounded-2xl shadow-sm transition flex items-center justify-center gap-2">
                    <span data-bn="নিরাপদে পেমেন্ট গেটওয়েতে যান" data-en="Proceed to Secure Payment Gateway">নিরাপদে পেমেন্ট গেটওয়েতে যান</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                </button>
                <div class="text-center mt-2.5 text-[11px] text-slate-400" data-bn="256-Bit SSL এনক্রিপ্টেড • কোনো কার্ড তথ্য অভয়ে সংরক্ষিত হয় না" data-en="256-Bit SSL Encrypted • Bank-Grade Security">
                    256-Bit SSL এনক্রিপ্টেড • কোনো কার্ড তথ্য অভয়ে সংরক্ষিত হয় না
                </div>
            </div>

        </div>

    </div>
</div>
