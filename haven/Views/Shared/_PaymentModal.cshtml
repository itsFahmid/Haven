<!-- Micro-Donation & Bangladeshi Checkout Modal -->
<div id="paymentModal" class="haven-modal fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/75 backdrop-blur-sm overflow-y-auto" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all my-8">
        
        <!-- Step 1: Payment Formulation View -->
        <div id="paymentStep1" class="p-6 md:p-8 space-y-6">
            
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-lg">
                        💝
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900" data-bn="মাইক্রো-অনুদান ও নিরাপদ পেমেন্ট" data-en="Micro-Donation & Safe Payment">
                            মাইক্রো-অনুদান ও নিরাপদ পেমেন্ট
                        </h3>
                        <p class="text-xs text-slate-500" data-bn="বাংলাদেশের তরুণ ও শিশুদের সংকট নিরসনে অংশ নিন" data-en="Empower Bangladeshi youth safety & mental health">
                            বাংলাদেশের তরুণ ও শিশুদের সংকট নিরসনে অংশ নিন
                        </p>
                    </div>
                </div>
                <button onclick="closeModal('paymentModal')" class="text-slate-400 hover:text-slate-700 p-2 rounded-full hover:bg-slate-100 transition" aria-label="Close">
                    ✕
                </button>
            </div>

            <!-- Amount Presets -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5" data-bn="অনুদানের পরিমাণ নির্বাচন করুন" data-en="Select Contribution Amount">
                    অনুদানের পরিমাণ নির্বাচন করুন
                </label>
                <div class="grid grid-cols-4 gap-2.5">
                    <button type="button" onclick="HavenPayment.setAmount(50, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳৫০
                    </button>
                    <button type="button" onclick="HavenPayment.setAmount(100, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-teal-700 text-center font-semibold text-sm transition bg-teal-700 text-white">
                        ৳১০০
                    </button>
                    <button type="button" onclick="HavenPayment.setAmount(500, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳৫০০
                    </button>
                    <button type="button" onclick="HavenPayment.setAmount(1000, this)" class="amount-preset-btn py-2.5 px-3 rounded-xl border border-slate-200 text-center font-semibold text-sm hover:border-teal-600 transition bg-white text-slate-700">
                        ৳১০০০
                    </button>
                </div>
                
                <div class="mt-3 relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold text-sm">৳</span>
                    <input type="number" id="customAmountInput" value="100" min="10" placeholder="Custom Amount in BDT" class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600 font-semibold text-slate-800" />
                </div>
            </div>

            <!-- Bangladeshi Payment Gateways -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5" data-bn="পেমেন্ট গেটওয়ে নির্বাচন করুন" data-en="Select Payment Method">
                    পেমেন্ট গেটওয়ে নির্বাচন করুন
                </label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    
                    <!-- bKash -->
                    <div onclick="HavenPayment.setGateway('bkash')" data-gateway="bkash" class="gateway-card active bkash p-3 rounded-2xl border-2 cursor-pointer text-center flex flex-col items-center justify-center transition hover:scale-[1.02]">
                        <div class="w-8 h-8 rounded-full bg-[#e2136e] text-white flex items-center justify-center font-bold text-xs mb-1">
                            bK
                        </div>
                        <span class="text-xs font-bold text-slate-800">bKash</span>
                    </div>

                    <!-- Nagad -->
                    <div onclick="HavenPayment.setGateway('nagad')" data-gateway="nagad" class="gateway-card p-3 rounded-2xl border-2 border-slate-200 cursor-pointer text-center flex flex-col items-center justify-center transition hover:scale-[1.02]">
                        <div class="w-8 h-8 rounded-full bg-[#f7941d] text-white flex items-center justify-center font-bold text-xs mb-1">
                            নগদ
                        </div>
                        <span class="text-xs font-bold text-slate-800">Nagad</span>
                    </div>

                    <!-- Rocket -->
                    <div onclick="HavenPayment.setGateway('rocket')" data-gateway="rocket" class="gateway-card p-3 rounded-2xl border-2 border-slate-200 cursor-pointer text-center flex flex-col items-center justify-center transition hover:scale-[1.02]">
                        <div class="w-8 h-8 rounded-full bg-[#8c3494] text-white flex items-center justify-center font-bold text-xs mb-1">
                            🚀
                        </div>
                        <span class="text-xs font-bold text-slate-800">Rocket</span>
                    </div>

                    <!-- SSLCommerz Cards -->
                    <div onclick="HavenPayment.setGateway('sslcommerz')" data-gateway="sslcommerz" class="gateway-card p-3 rounded-2xl border-2 border-slate-200 cursor-pointer text-center flex flex-col items-center justify-center transition hover:scale-[1.02]">
                        <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs mb-1">
                            💳
                        </div>
                        <span class="text-xs font-bold text-slate-800">Cards/SSL</span>
                    </div>
                </div>

                <div id="paymentGatewayHelper" class="mt-2.5 text-xs text-teal-800 bg-teal-50/80 p-2.5 rounded-xl font-medium border border-teal-100 flex items-center gap-2">
                    <span>💡</span> bKash Merchant / Direct Payment: 01700-000000 (Haven Safe Foundation)
                </div>
            </div>

            <!-- Hall of Fame & Privacy Options -->
            <div class="space-y-3 pt-1">
                <label class="flex items-start gap-3 cursor-pointer select-none">
                    <input type="checkbox" id="optHallOfFameCheck" class="mt-1 rounded text-teal-600 focus:ring-teal-500 h-4 w-4 border-slate-300" onchange="document.getElementById('donorNameContainer').classList.toggle('hidden', !this.checked)" />
                    <div>
                        <div class="text-xs font-semibold text-slate-800" data-bn="হেভেন 'হল অফ ফেম' (Hall of Fame) দাতা তালিকায় নাম প্রকাশ করুন" data-en="Feature my name on the Haven 'Hall of Fame' donor list">
                            হেভেন 'হল অফ ফেম' (Hall of Fame) দাতা তালিকায় নাম প্রকাশ করুন
                        </div>
                        <div class="text-[11px] text-slate-500" data-bn="অন্যান্য তরুণদের অনুপ্রাণিত করতে আপনার অবদান প্রদর্শিত হবে" data-en="Inspire other youth supporters across Bangladesh">
                            অন্যান্য তরুণদের অনুপ্রাণিত করতে আপনার অবদান প্রদর্শিত হবে
                        </div>
                    </div>
                </label>

                <div id="donorNameContainer" class="hidden pl-7 space-y-2">
                    <input type="text" id="donorNameInput" placeholder="Your Display Name / City (e.g. Tanvir, Dhaka)" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-600 focus:outline-none" />
                </div>

                <label class="flex items-start gap-3 cursor-pointer select-none">
                    <input type="checkbox" id="payAnonymousCheck" checked class="mt-1 rounded text-teal-600 focus:ring-teal-500 h-4 w-4 border-slate-300" />
                    <div>
                        <div class="text-xs font-semibold text-slate-800" data-bn="সম্পূর্ণ গোপনীয় ও বেনামী লেনদেন বজায় রাখুন" data-en="Keep payment 100% confidential & anonymous">
                            সম্পূর্ণ গোপনীয় ও বেনামী লেনদেন বজায় রাখুন
                        </div>
                        <div class="text-[11px] text-slate-500" data-bn="আপনার আর্থিক তথ্য বা পরিচয় কোনো তৃতীয় পক্ষের কাছে সংরক্ষণ করা হবে না" data-en="Zero sensitive identity retention per Haven Privacy Shield">
                            আপনার আর্থিক তথ্য বা পরিচয় কোনো তৃতীয় পক্ষের কাছে সংরক্ষণ করা হবে না
                        </div>
                    </div>
                </label>
            </div>

            <!-- Actions -->
            <div class="pt-2">
                <button type="button" id="confirmPaymentBtn" onclick="HavenPayment.processPayment()" class="w-full py-3.5 px-5 bg-gradient-to-r from-teal-700 to-teal-800 hover:from-teal-800 hover:to-teal-900 text-white font-bold text-sm rounded-2xl shadow-lg shadow-teal-900/10 transition transform active:scale-[0.98] flex items-center justify-center gap-2">
                    <span data-bn="নিরাপদে অনুদান প্রদান করুন" data-en="Proceed to Secure Payment">নিরাপদে অনুদান প্রদান করুন</span> 🔒
                </button>
                <div class="text-center mt-2.5 text-[11px] text-slate-400" data-bn="256-Bit SSL এনক্রিপ্টেড ও সম্পূর্ণ নিরাপদ লেনদেন" data-en="256-Bit SSL Encrypted & Bank-Grade Security">
                    256-Bit SSL এনক্রিপ্টেড ও সম্পূর্ণ নিরাপদ লেনদেন
                </div>
            </div>

        </div>

        <!-- Step 2: Instant Success & Receipt View -->
        <div id="paymentStepSuccess" class="p-6 md:p-8 space-y-6 hidden text-center">
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto pulse-teal">
                ✓
            </div>
            
            <div>
                <h3 class="text-xl font-bold text-slate-900" data-bn="অনুদানের জন্য আন্তরিক ধন্যবাদ!" data-en="Thank You For Your Kindness!">
                    অনুদানের জন্য আন্তরিক ধন্যবাদ!
                </h3>
                <p class="text-xs text-slate-600 mt-1 max-w-sm mx-auto" data-bn="আপনার এই অবদান কোনো এক বিপদগ্রস্ত কিশোর বা তরুণের বিনামূল্যে থেরাপি ও সাইবার সুরক্ষায় ব্যবহার করা হবে।" data-en="Your contribution provides immediate free therapy and emergency crisis recovery for vulnerable youth.">
                    আপনার এই অবদান কোনো এক বিপদগ্রস্ত কিশোর বা তরুণের বিনামূল্যে থেরাপি ও সাইবার সুরক্ষায় ব্যবহার করা হবে।
                </p>
            </div>

            <!-- Receipt Summary Card -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-left text-xs space-y-2">
                <div class="flex justify-between text-slate-600">
                    <span data-bn="ট্রানজ্যাকশন আইডি:" data-en="Transaction ID:">ট্রানজ্যাকশন আইডি:</span>
                    <span id="receiptTrxId" class="font-mono font-bold text-slate-900">TXN9482910</span>
                </div>
                <div class="flex justify-between text-slate-600">
                    <span data-bn="পরিশোধের মাধ্যম:" data-en="Gateway:">পরিশোধের মাধ্যম:</span>
                    <span id="receiptGateway" class="font-bold text-slate-900">BKASH</span>
                </div>
                <div class="flex justify-between text-slate-600 border-t border-slate-200 pt-2 font-bold text-sm text-slate-900">
                    <span data-bn="মোট পরিমাণ:" data-en="Total Amount:">মোট পরিমাণ:</span>
                    <span id="receiptAmount" class="text-teal-700">৳১০০</span>
                </div>
            </div>

            <div class="pt-2 flex flex-col gap-2">
                <button onclick="HavenPayment.resetPaymentModal(); closeModal('paymentModal')" class="w-full py-3 bg-teal-700 hover:bg-teal-800 text-white font-semibold text-sm rounded-xl transition" data-bn="সম্পন্ন হয়েছে / বন্ধ করুন" data-en="Done / Close Modal">
                    সম্পন্ন হয়েছে / বন্ধ করুন
                </button>
            </div>
        </div>

    </div>
</div>
