<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HAVEN | Bangladesh Youth Safety & Mental Health Sanctuary</title>
    <meta name="description" content="HAVEN is an anonymous, trauma-informed child & adult safety education, mental health, and emergency recovery platform for Bangladesh." />
    
    <!-- Google Fonts: Hind Siliguri & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN
         NOTE (Performance P1): The JIT CDN script compiles CSS at runtime.
         For production, run `npx tailwindcss -o wwwroot/css/tailwind.css --minify`
         and replace this with: <link rel="stylesheet" href="~/css/tailwind.css" />
    -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        haven: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                            alert: '#e11d48',
                            slate: '#1e293b'
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="min-h-screen flex flex-col antialiased bg-[#fdfcf9] text-slate-800" data-current-lang="bn">

    <!-- Top Emergency Safe Notice Ribbon -->
    <div class="bg-gradient-to-r from-teal-950 via-slate-900 to-teal-950 text-white text-xs py-2 px-4 border-b border-teal-800/40 shadow-xs">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 tracking-tight">
                    <span aria-hidden="true">🔒</span>
                    <span>100% Anonymous Safe Space</span>
                </span>
                <span class="hidden sm:inline text-slate-300 text-[11px]" data-bn="আপনার পরিচয় সম্পূর্ণ গোপন থাকবে। কোনো লগইন প্রয়োজন নেই।" data-en="Zero registration required. Your privacy & safety are strictly protected.">
                    আপনার পরিচয় সম্পূর্ণ গোপন থাকবে। কোনো লগইন প্রয়োজন নেই।
                </span>
            </div>
            
            <div class="flex items-center gap-3 text-[11px]">
                <div class="flex items-center gap-1.5 text-rose-300 font-semibold">
                    <span aria-hidden="true">🚨</span>
                    <span data-bn="জরুরি হেল্পলাইন:" data-en="National Hotlines:">জরুরি হেল্পলাইন:</span>
                    <a href="tel:1098" class="underline hover:text-white focus-visible:ring-1 focus-visible:ring-rose-300 rounded px-1 transition" aria-label="Call Child Helpline 1098">1098</a>
                    <span class="text-teal-700" aria-hidden="true">•</span>
                    <a href="tel:999" class="underline hover:text-white focus-visible:ring-1 focus-visible:ring-rose-300 rounded px-1 transition" aria-label="Call National Emergency 999">999</a>
                    <span class="text-teal-700" aria-hidden="true">•</span>
                    <a href="tel:109" class="underline hover:text-white focus-visible:ring-1 focus-visible:ring-rose-300 rounded px-1 transition" aria-label="Call Violence Against Women Helpline 109">109</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Brand Logo -->
                <div class="flex items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2 rounded-2xl p-1 -ml-1 transition" aria-label="HAVEN - হোম পাতায় যান">
                        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-teal-700 via-teal-600 to-teal-500 text-white flex items-center justify-center shadow-md shadow-teal-900/15 group-hover:scale-105 group-hover:shadow-teal-900/25 transition-all duration-250" aria-hidden="true">
                            <svg class="w-6 h-6 transform group-hover:rotate-3 transition-transform duration-250" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5">
                                <span class="text-2xl font-black tracking-tight text-slate-900 font-sans group-hover:text-teal-800 transition-colors">HAVEN</span>
                                <span class="px-2 py-0.5 text-[10px] font-extrabold bg-teal-100/80 text-teal-800 rounded-md tracking-wider border border-teal-200/60">হেভেন</span>
                            </div>
                            <p class="text-[11px] text-slate-500 font-medium tracking-tight group-hover:text-slate-600 transition-colors" data-bn="তারুণ্যের সুরক্ষা ও মানসিক স্বাস্থ্য আশ্রয়" data-en="Youth Safety & Mental Health Sanctuary">
                                তারুণ্যের সুরক্ষা ও মানসিক স্বাস্থ্য আশ্রয়
                            </p>
                        </div>
                    </a>
                </div>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" aria-label="প্রধান নেভিগেশন">
                    <a asp-controller="Home" asp-action="Index" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-teal-900 hover:bg-teal-50/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 transition-all duration-150" data-bn="হোম" data-en="Home">
                        হোম
                    </a>
                    <a asp-controller="Courses" asp-action="Index" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-teal-900 hover:bg-teal-50/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 transition-all duration-150" data-bn="নিরাপত্তা কোর্স" data-en="Safety Courses">
                        নিরাপত্তা কোর্স
                    </a>
                    <a asp-controller="Hotline" asp-action="Index" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-teal-900 hover:bg-teal-50/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 transition-all duration-150 flex items-center gap-1.5 group">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse group-hover:scale-125 transition-transform" aria-hidden="true"></span>
                        <span data-bn="এআই সুরক্ষা হটলাইন" data-en="AI Safety Assistant">এআই সুরক্ষা হটলাইন</span>
                    </a>
                    <a asp-controller="Therapy" asp-action="Index" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-teal-900 hover:bg-teal-50/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 transition-all duration-150" data-bn="ভেরিফায়েড থেরাপিস্ট" data-en="Therapy Directory">
                        ভেরিফায়েড থেরাপিস্ট
                    </a>
                    <button type="button" onclick="openModal('paymentModal')" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-amber-900 bg-amber-50/90 hover:bg-amber-100/80 border border-amber-200/90 hover:border-amber-300 shadow-2xs hover:shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 transition-all duration-150 flex items-center gap-1.5 active:scale-97" aria-label="অনুদান প্রদান করুন">
                        <span aria-hidden="true" class="text-xs">💝</span>
                        <span data-bn="অনুদান" data-en="Donate">অনুদান</span>
                    </button>

                    <!-- Auth State Dynamic Navigation -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="flex items-center space-x-1 pl-2.5 border-l border-slate-200/80">
                            <a asp-controller="Account" asp-action="Profile" class="px-3 py-1.5 rounded-xl text-xs font-bold text-teal-800 bg-teal-50/80 hover:bg-teal-100 border border-teal-200/80 focus-visible:ring-2 focus-visible:ring-teal-600 transition-all flex items-center gap-1.5 min-h-[44px]" title="প্রোফাইল" aria-label="প্রোফাইল দেখুন">
                                <span aria-hidden="true">👤</span>
                                <span class="max-w-[100px] truncate">@(User.Identity.Name ?? "প্রোফাইল")</span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-bold text-rose-700 hover:text-rose-800 hover:bg-rose-50/80 focus-visible:ring-2 focus-visible:ring-rose-500 transition-all flex items-center gap-1 min-h-[44px] min-w-[44px]" title="Log Out" aria-label="লগআউট">
                                    <span aria-hidden="true">🚪</span>
                                    <span class="hidden lg:inline" data-bn="লগআউট" data-en="Logout">লগআউট</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-1.5 pl-2.5 border-l border-slate-200/80">
                            <a asp-controller="Account" asp-action="Login" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 hover:text-teal-700 hover:bg-teal-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 transition-all" data-bn="লগইন" data-en="Log In">
                                লগইন
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-teal-700 hover:bg-teal-800 active:scale-97 shadow-sm hover:shadow-teal-900/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2 transition-all" data-bn="রেজিস্ট্রেশন" data-en="Sign Up">
                                রেজিস্ট্রেশন
                            </a>
                        </div>
                    }
                </nav>

                <!-- Right Header Actions: Language Switcher & Quick Exit -->
                <div class="flex items-center gap-2.5 sm:gap-3.5">
                    
                    <!-- Bilingual Language Switcher -->
                    <div class="bg-slate-100/90 p-1 rounded-xl flex items-center border border-slate-200/80 shadow-2xs" role="group" aria-label="ভাষা পছন্দ করুন">
                        <button type="button" onclick="HavenLang.set('bn')" data-set-lang="bn" class="lang-toggle-btn px-3 py-1 rounded-lg text-xs font-bold transition-all duration-150 bg-teal-700 text-white shadow-xs min-h-[36px] min-w-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600" aria-label="বাংলায় পরিবর্তন করুন" aria-pressed="true">
                            বাংলা
                        </button>
                        <button type="button" onclick="HavenLang.set('en')" data-set-lang="en" class="lang-toggle-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-200/60 transition-all duration-150 min-h-[36px] min-w-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600" aria-label="Switch to English" aria-pressed="false">
                            EN
                        </button>
                    </div>

                    <!-- Universal Quick Exit Button -->
                    <button type="button" id="quickExitBtn" onclick="window.havenQuickExit()" title="Press ESC to quickly exit this page immediately" aria-label="জরুরি প্রস্থান — এই পাতা তাৎক্ষণিকভাবে বন্ধ করুন (ESC)" class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-700 hover:to-rose-800 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-rose-900/20 hover:shadow-lg hover:shadow-rose-900/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-2 transition-all transform active:scale-95 pulse-red min-h-[44px]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        <span data-bn="জরুরি প্রস্থান (ESC)" data-en="Quick Exit (ESC)">জরুরি প্রস্থান (ESC)</span>
                    </button>

                </div>

            </div>
        </div>

        <!-- Mobile Secondary Nav Bar -->
        <nav class="md:hidden flex items-center justify-around py-2 border-t border-slate-200/80 bg-slate-50/95 backdrop-blur-md text-xs font-semibold text-slate-600 shadow-2xs" aria-label="মোবাইল নেভিগেশন">
            <a asp-controller="Home" asp-action="Index" class="hover:text-teal-700 min-h-[44px] flex items-center px-2.5 rounded-lg transition-colors" data-bn="হোম" data-en="Home">হোম</a>
            <a asp-controller="Courses" asp-action="Index" class="hover:text-teal-700 min-h-[44px] flex items-center px-2.5 rounded-lg transition-colors" data-bn="কোর্স" data-en="Courses">কোর্স</a>
            <a asp-controller="Hotline" asp-action="Index" class="text-teal-700 font-bold flex items-center gap-1 min-h-[44px] px-2.5 rounded-lg transition-colors" aria-label="এআই সুরক্ষা হটলাইন">
                <span aria-hidden="true">🤖</span> <span data-bn="এআই" data-en="AI">এআই</span>
            </a>
            <a asp-controller="Therapy" asp-action="Index" class="hover:text-teal-700 min-h-[44px] flex items-center px-2.5 rounded-lg transition-colors" data-bn="থেরাপিস্ট" data-en="Therapy">থেরাপিস্ট</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Profile" class="text-teal-700 font-bold min-h-[44px] flex items-center gap-1 px-2.5 rounded-lg transition-colors" aria-label="প্রোফাইল দেখুন">
                    <span aria-hidden="true">👤</span> <span data-bn="প্রোফাইল" data-en="Profile">প্রোফাইল</span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="text-teal-700 font-bold min-h-[44px] flex items-center px-2.5 rounded-lg transition-colors" data-bn="লগইন" data-en="Login">লগইন</a>
            }
        </nav>
    </header>

    <!-- Main Dynamic Content Container -->
    <main role="main" class="flex-grow">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
                <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm font-semibold flex items-center justify-between shadow-sm animate-fade-in" role="status" aria-live="polite">
                    <div class="flex items-center gap-2.5">
                        <span class="text-lg" aria-hidden="true">✅</span>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg text-sm" aria-label="বার্তা বন্ধ করুন">✕</button>
                </div>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
                <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-sky-900 text-sm font-semibold flex items-center justify-between shadow-sm animate-fade-in" role="status" aria-live="polite">
                    <div class="flex items-center gap-2.5">
                        <span class="text-lg" aria-hidden="true">ℹ️</span>
                        <span>@TempData["InfoMessage"]</span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-sky-700 hover:text-sky-900 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg text-sm" aria-label="বার্তা বন্ধ করুন">✕</button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Common National Helpline Emergency Alert Banner -->
    <section class="bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white py-12 border-t border-teal-800/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-8">
                <span class="px-3 py-1 bg-rose-500/20 text-rose-300 border border-rose-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
                    24/7 Bangladesh Crisis Lines
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold mt-3 text-white" data-bn="জরুরি সহায়তা প্রয়োজন? আমরা সার্বক্ষণিক প্রস্তুত" data-en="Need Urgent Emergency Help? Free National Helplines">
                    জরুরি সহায়তা প্রয়োজন? আমরা সার্বক্ষণিক প্রস্তুত
                </h2>
                <p class="text-slate-300 text-sm mt-2" data-bn="যেকোনো সংকট, নির্যাতন বা মানসিক বিপর্যয়ে নিচের টোল-ফ্রি নম্বরগুলোতে তাৎক্ষণিক কল করুন।" data-en="Call these official toll-free Bangladesh emergency numbers anytime for instant dispatch and rescue.">
                    যেকোনো সংকট, নির্যাতন বা মানসিক বিপর্যয়ে নিচের টোল-ফ্রি নম্বরগুলোতে তাৎক্ষণিক কল করুন।
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- 999 -->
                <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-5 hover:bg-white/15 transition haven-card">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-3xl font-black text-rose-400">999</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300">Toll-Free</span>
                    </div>
                    <h3 class="font-bold text-white text-base" data-bn="জাতীয় জরুরি সেবা (৯৯৯)" data-en="National Emergency (999)">জাতীয় জরুরি সেবা (৯৯৯)</h3>
                    <p class="text-xs text-slate-300 mt-1" data-bn="পুলিশ, অ্যাম্বুলেন্স ও ফায়ার সার্ভিসের দ্রুততম সহায়তা।" data-en="Instant police, ambulance, and rescue dispatch across Bangladesh.">পুলিশ, অ্যাম্বুলেন্স ও ফায়ার সার্ভিস।</p>
                    <a href="tel:999" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-rose-300 hover:text-white">
                        <span>📞 সরাসরি কল করুন</span> ➔
                    </a>
                </div>

                <!-- 1098 -->
                <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-5 hover:bg-white/15 transition haven-card">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-3xl font-black text-emerald-400">1098</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Toll-Free</span>
                    </div>
                    <h3 class="font-bold text-white text-base" data-bn="চাইল্ড হেল্পলাইন বাংলাদেশ" data-en="Child Helpline (1098)">চাইল্ড হেল্পলাইন বাংলাদেশ</h3>
