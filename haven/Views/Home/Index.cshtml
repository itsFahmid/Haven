@model Obhoy.Models.HomeViewModel
@{
    ViewData["Title"] = "হোম | Home";
}

<!-- Hero Section -->
<section class="relative pt-8 pb-16 md:pt-16 md:pb-24 bg-gradient-to-b from-teal-50/50 via-[#fdfcf9] to-[#fdfcf9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Hero Left Copy -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                
                <!-- Safe badge & Theme Song Play Button -->
                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-100/90 border border-teal-200 text-teal-900 text-xs font-bold shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse" aria-hidden="true"></span>
                        <span data-bn="বাংলাদেশের প্রথম সম্পূর্ণ এনক্রিপ্টেড যুব সুরক্ষা ও মানসিক স্বাস্থ্য প্ল্যাটফর্ম" data-en="Bangladesh's First 100% Encrypted Youth & Family Safety Sanctuary">
                            বাংলাদেশের প্রথম সম্পূর্ণ এনক্রিপ্টেড যুব সুরক্ষা ও মানসিক স্বাস্থ্য প্ল্যাটফর্ম
                        </span>
                    </div>

                    <!-- Small Theme Song Play Button -->
                    <button type="button" 
                            id="obhoyThemePlayBtn" 
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/95 hover:bg-teal-50 text-teal-900 border border-teal-200/90 hover:border-teal-400 shadow-2xs hover:shadow-xs transition-all duration-200 text-xs font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 group cursor-pointer active:scale-95 select-none"
                            aria-label="অভয় থিম সং চালান" 
                            title="OBHOY Theme Song">
                        <span id="themePlayIconWrap" class="w-5 h-5 rounded-full bg-teal-700 text-white flex items-center justify-center group-hover:scale-105 group-hover:bg-teal-800 transition-all shadow-xs">
                            <!-- Play SVG -->
                            <svg id="themePlaySvg" class="w-2.5 h-2.5 ml-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            <!-- Pause SVG -->
                            <svg id="themePauseSvg" class="w-2.5 h-2.5 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                            </svg>
                        </span>

                        <!-- Animated Sound Bars -->
                        <span id="themeSoundBars" class="hidden items-center gap-0.5 h-3" aria-hidden="true">
                            <span class="w-0.5 bg-teal-600 rounded-full animate-music-bar-1 h-2"></span>
                            <span class="w-0.5 bg-teal-600 rounded-full animate-music-bar-2 h-3"></span>
                            <span class="w-0.5 bg-teal-600 rounded-full animate-music-bar-3 h-1.5"></span>
                            <span class="w-0.5 bg-teal-600 rounded-full animate-music-bar-4 h-2.5"></span>
                        </span>

                        <span id="themeBtnLabel" data-bn="থিম সং শুনুন" data-en="Play Theme Song">থিম সং শুনুন</span>
                        <span id="themeTimeDisplay" class="text-[11px] text-teal-700 font-semibold font-mono hidden tabular-nums">0:00</span>
                    </button>
                </div>

                <!-- Main Hero Headline -->
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.18]">
                    <span class="block text-teal-800" data-bn="আপনার হাতটি বাড়িয়ে দিন, আমরা আপনার পাশে আছি।" data-en="Extend your hand, we're here for you.">
                        আপনার হাতটি বাড়িয়ে দিন, আমরা আপনার পাশে আছি।
                    </span>
                    <span class="block text-slate-700 text-2xl sm:text-3xl md:text-4xl font-semibold mt-2" data-bn="আপনার জীবনের মূল্য অপরিসীম।" data-en="You matter, just like others.">
                        আপনার জীবনের মূল্য অপরিসীম।
                    </span>
                </h1>

                <!-- Hero Subtitle -->
                <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed" data-bn="সাইবার ব্ল্যাকমেইল, মানসিক হতাশা, ব্যক্তিগত সীমানা বা সংকটময় মুহূর্তে অভয় আপনার নির্ভরযোগ্য নিরাপদ আশ্রয়। কোনো নাম বা লগইন ছাড়াই তাৎক্ষণিক কাউন্সেলিং এবং আইনি সুরক্ষা গাইড পান।" data-en="Whether dealing with cyber extortion, acute depression, relationship trauma, or digital privacy threats, OBHOY offers unconditional safety without signups or tracking.">
                    সাইবার ব্ল্যাকমেইল, মানসিক হতাশা, ব্যক্তিগত সীমানা বা সংকটময় মুহূর্তে অভয় আপনার নির্ভরযোগ্য নিরাপদ আশ্রয়। কোনো নাম বা লগইন ছাড়াই তাৎক্ষণিক কাউন্সেলিং এবং আইনি সুরক্ষা গাইড পান।
                </p>

                <!-- Hero Action Buttons -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                    <a asp-controller="Hotline" asp-action="Index" class="w-full sm:w-auto px-7 py-4 bg-teal-700 hover:bg-teal-800 text-white font-bold text-base rounded-2xl shadow-lg shadow-teal-900/15 transition flex items-center justify-center gap-3">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        <span data-bn="বেনামে কথা বলুন (এআই হটলাইন)" data-en="Talk Anonymously (AI Hotline)">বেনামে কথা বলুন (এআই হটলাইন)</span>
                    </a>

                    <a asp-controller="Courses" asp-action="Index" class="w-full sm:w-auto px-7 py-4 bg-white hover:bg-slate-50 text-slate-800 font-bold text-base rounded-2xl border border-slate-300 shadow-xs transition flex items-center justify-center gap-2">
                        <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                        </svg>
                        <span data-bn="সুরক্ষা কোর্স দেখুন" data-en="Explore Safety Hub">সুরক্ষা কোর্স দেখুন</span>
                    </a>

                    <button type="button" onclick="triggerCrisisEscalation('Emergency SOS')" class="w-full sm:w-auto px-5 py-4 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold text-sm rounded-2xl transition flex items-center justify-center gap-2">
                        <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span data-bn="জরুরি সংকট SOS" data-en="Crisis SOS">জরুরি সংকট SOS</span>
                    </button>
                </div>

                <!-- Safe Space Assurances -->
                <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-600 font-medium">
                    <div class="flex items-center gap-1.5">
                        <span class="text-teal-700 font-bold" aria-hidden="true">✓</span>
                        <span data-bn="১০০% পরিচয় গোপন" data-en="Zero Identity Logging">১০০% পরিচয় গোপন</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-teal-700 font-bold" aria-hidden="true">✓</span>
                        <span data-bn="বিএমডিসি রেজিস্টার্ড থেরাপিস্ট" data-en="BMDC Verified Doctors">বিএমডিসি রেজিস্টার্ড থেরাপিস্ট</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-teal-700 font-bold" aria-hidden="true">✓</span>
                        <span data-bn="সম্পূর্ণ বিনামূল্যে উন্মুক্ত" data-en="100% Free & Accessible">সম্পূর্ণ বিনামূল্যে উন্মুক্ত</span>
                    </div>
                </div>

            </div>

            <!-- Hero Right Interactive Card -->
            <div class="lg:col-span-5">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100">

                    <!-- Card Header -->
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-teal-700 text-white flex items-center justify-center font-bold">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 text-sm" data-bn="তাৎক্ষণিক সুরক্ষা ড্যাশবোর্ড" data-en="Instant Safety Quick-Bar">তাৎক্ষণিক সুরক্ষা ড্যাশবোর্ড</h3>
                                <span class="text-[11px] text-emerald-700 font-bold">● Active 24/7 Assistance</span>
                            </div>
                        </div>
                        <button onclick="ObhoyChat.sendMessage()" class="text-xs text-teal-700 hover:text-teal-900 font-bold" data-bn="চ্যাট চালু করুন" data-en="Launch Chat">
                            চ্যাট চালু ➔
                        </button>
                    </div>

                    <!-- Interactive Grounding Exercise Widget -->
                    <div class="my-5 p-4 rounded-2xl bg-teal-50/70 border border-teal-200 text-center">
                        <div class="text-xs font-bold text-teal-950 mb-1 flex items-center justify-center gap-1.5" data-bn="মন শান্ত করার ৪-৭-৮ ব্রিদিং সার্কেল" data-en="Somatic 4-7-8 Breathing Reset">
                            <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.684a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                            </svg>
                            <span data-bn="মন শান্ত করার ৪-৭-৮ ব্রিদিং সার্কেল" data-en="Somatic 4-7-8 Breathing Reset">মন শান্ত করার ৪-৭-৮ ব্রিদিং সার্কেল</span>
                        </div>
                        <div class="flex items-center justify-center py-4">
                            <div class="w-20 h-20 rounded-full bg-teal-100 flex items-center justify-center breathing-bubble border border-teal-300">
                                <span class="text-teal-900 font-extrabold text-xs" data-bn="শ্বাস নিন" data-en="Breathe">শ্বাস নিন</span>
                            </div>
                        </div>
                        <p class="text-[11px] text-teal-900" data-bn="তীব্র উদ্বেগ বা প্যানিক অনুভব হলে এই ছন্দময় বৃত্তটির সাথে গভীর শ্বাস নিন।" data-en="Follow the rhythm to regulate your nervous system instantly.">
                            তীব্র উদ্বেগ বা প্যানিক অনুভব হলে এই ছন্দময় বৃত্তটির সাথে গভীর শ্বাস নিন।
                        </p>
                    </div>

                    <!-- Quick Direct Dial Rows -->
                    <div class="space-y-2.5">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-bn="জরুরি সরাসরি ডায়াল" data-en="Emergency Direct Dial">জরুরি সরাসরি ডায়াল</div>
                        
                        <a href="tel:1098" class="flex items-center justify-between p-3 rounded-xl bg-amber-50/80 hover:bg-amber-100/80 border border-amber-200 transition">
                            <div class="flex items-center gap-2.5">
                                <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <div>
                                    <div class="text-xs font-bold text-slate-900" data-bn="চাইল্ড হেল্পলাইন (১০৯৮)" data-en="Child Helpline (1098)">চাইল্ড হেল্পলাইন (১০৯৮)</div>
                                    <div class="text-[10px] text-amber-900 font-medium" data-bn="শিশু ও কিশোরদের বিপদ উদ্ধার" data-en="Child protection & rescue">শিশু ও কিশোরদের বিপদ উদ্ধার</div>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 bg-amber-800 text-white font-bold text-xs rounded-lg">1098</span>
                        </a>

                        <a href="tel:999" class="flex items-center justify-between p-3 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-300 transition">
                            <div class="flex items-center gap-2.5">
                                <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                <div>
                                    <div class="text-xs font-bold text-slate-900" data-bn="জাতীয় জরুরি সেবা (৯৯৯)" data-en="National Emergency (999)">জাতীয় জরুরি সেবা (৯৯৯)</div>
                                    <div class="text-[10px] text-slate-600 font-medium" data-bn="পুলিশ, অ্যাম্বুলেন্স ও উদ্ধার" data-en="Police, ambulance & fire">পুলিশ, অ্যাম্বুলেন্স ও উদ্ধার</div>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 bg-slate-900 text-white font-bold text-xs rounded-lg">999</span>
                        </a>
                    </div>

                    <!-- Bottom Quick Exit Warning -->
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                        <span data-bn="গোপনীয় প্রস্থান করতে ESC চাপুন" data-en="Press ESC to quickly leave page">গোপনীয় প্রস্থান করতে ESC চাপুন</span>
                        <button onclick="window.obhoyQuickExit()" class="text-slate-700 hover:text-slate-900 hover:underline font-bold" data-bn="Exit Now" data-en="Exit Now">Exit Now</button>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>

<!-- Bangladeshi Emergency Hotline Quick Alert Bar -->
<section id="emergencySection" class="bg-white border-y border-slate-200 py-8 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-2xl font-extrabold text-slate-900" data-bn="বাংলাদেশের সরকারি ও জরুরি সংকট নিরসন নম্বর" data-en="Official Bangladesh Emergency Hotlines">
                    বাংলাদেশের সরকারি ও জরুরি সংকট নিরসন নম্বর
                </h2>
            </div>
            <p class="text-xs text-slate-500 max-w-md" data-bn="যেকোনো শারীরিক বিপদ, সাইবার নির্যাতন বা মানসিক বিপর্যয়ে এই নম্বরগুলো সম্পূর্ণ টোল-ফ্রি ও সার্বক্ষণিক সক্রিয়।" data-en="All hotlines are officially operated, confidential, and 100% toll-free across all BD telecom operators.">
                যেকোনো শারীরিক বিপদ, সাইবার নির্যাতন বা মানসিক বিপর্যয়ে এই নম্বরগুলো সম্পূর্ণ টোল-ফ্রি ও সার্বক্ষণিক সক্রিয়।
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var hotline in Model.Hotlines)
            {
                <div class="p-5 rounded-2xl border border-slate-200 hover:border-teal-600 bg-slate-50 hover:bg-white transition">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-2xl font-black text-slate-900">@hotline.Number</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(hotline.IsTollFree ? "bg-emerald-100 text-emerald-900 border border-emerald-200" : "bg-sky-100 text-sky-900 border border-sky-200")">
                            @(hotline.IsTollFree ? "টোল-ফ্রি" : "সহায়তা সেল")
                        </span>
                    </div>
                    <div class="text-xs font-bold text-slate-800 mb-1" data-bn="@hotline.NameBn" data-en="@hotline.NameEn">
                        @hotline.NameBn
                    </div>
                    <div class="text-[11px] text-slate-500 line-clamp-2" data-bn="@hotline.DescriptionBn" data-en="@hotline.DescriptionEn">
                        @hotline.DescriptionBn
                    </div>
                    <div class="mt-3 pt-2 border-t border-slate-200 flex items-center justify-between">
                        <a href="tel:@hotline.Number" class="text-xs font-bold text-teal-700 hover:text-teal-900 inline-flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
