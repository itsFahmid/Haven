}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="space-y-3">
        <span class="px-3 py-1 bg-teal-100 text-teal-800 rounded-full text-xs font-bold uppercase tracking-wider">
            Zero-Knowledge Privacy Pledge
        </span>
        <h1 class="text-3xl font-extrabold text-slate-900" data-bn="হেভেন গোপনীয়তা ও ডাটা সুরক্ষা অঙ্গীকার" data-en="HAVEN Safe Space Privacy Shield">
