@model IEnumerable<Haven.Controllers.CommunityPost>
@{
    ViewData["Title"] = "বেনামী সাপোর্ট ফোরাম & রিপোর্ট | Anonymous Community";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Hero Header -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-3">
            <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
                Anonymous Peer Support & Incident Guard
            </span>
            <h1 class="text-3xl sm:text-4xl font-black tracking-tight" data-bn="বেনামী সমমনা সাপোর্ট ফোরাম (UC-20)" data-en="Anonymous Peer Support Community (UC-20)">
                বেনামী সমমনা সাপোর্ট ফোরাম (UC-20)
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                র্যান্ডম অ্যালিয়াস (Random Aliases) ব্যবহার করে নিজের পরিচয় গোপন রেখে অভিজ্ঞতার কথা শুনুন এবং জানুন।
            </p>
        </div>

        <a asp-action="ReportIncident" class="px-5 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center gap-2 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span data-bn="নিরাপত্তা ঘটনা রিপোর্ট করুন (UC-21)" data-en="Report Safety Incident (UC-21)">নিরাপত্তা ঘটনা রিপোর্ট করুন (UC-21)</span>
        </a>
    </div>

    <!-- Posts Feed Grid -->
    <div class="space-y-4">
        @foreach (var post in Model)
        {
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-8 h-8 rounded-xl bg-teal-100 text-teal-800 flex items-center justify-center font-bold text-xs font-mono">
                            @post.AnonymousAlias.Substring(0, 2)
                        </span>
                        <div>
                            <div class="text-xs font-bold text-slate-800">@post.AnonymousAlias</div>
                            <div class="text-[10px] text-slate-400">@post.CreatedAt.ToString("g")</div>
                        </div>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200">
                        @post.Topic
                    </span>
                </div>

                <h3 class="text-base font-bold text-slate-900">@post.Title</h3>
                <p class="text-xs text-slate-600 leading-relaxed">@post.Content</p>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                    <span>💬 @post.CommentCount টি মন্তব্য</span>
                    <button type="button" onclick="showToast('মন্তব্য সেশন গোপন রাখা হয়েছে')" class="text-teal-700 font-bold hover:underline">
                        মন্তব্য যুক্ত করুন ➔
                    </button>
                </div>
            </div>
        }
    </div>

</div>
