@{
    ViewData["Title"] = "SSLCommerz Sandbox Simulator";
    var tranId = ViewBag.TranId as string ?? "OBH-MOCK-TXN";
    var amount = (decimal)(ViewBag.Amount ?? 100);
    var purpose = ViewBag.Purpose as string ?? "Obhoy Sanctuary Donation";
    var fallbackReason = ViewBag.FallbackReason as string;
}

<div class="max-w-xl mx-auto px-4 py-12 space-y-6">
    
    <!-- Simulation Warning Banner -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs text-amber-900 flex items-start gap-3">
        <div class="text-xl">🧪</div>
        <div>
            <div class="font-bold text-amber-950">SSLCommerz Developer Sandbox Simulator</div>
            <p class="text-[11px] text-amber-800 mt-0.5">
                This is a secure development simulator representing the SSLCommerz hosted gateway. You can test complete success, failure, and cancellation flows without real money.
                @if (!string.IsNullOrEmpty(fallbackReason))
                {
                    <span class="block mt-1 text-slate-500 font-mono">(Live gateway fallback: @fallbackReason)</span>
                }
            </p>
        </div>
    </div>

    <!-- Simulator Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
        
        <div class="bg-slate-900 text-white p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500 text-white flex items-center justify-center font-bold text-lg">
                    SSL
                </div>
                <div>
                    <h2 class="text-base font-bold">SSLCommerz Secure Payment</h2>
                    <span class="text-xs text-slate-400">Sandbox Environment (256-bit SSL)</span>
                </div>
            </div>
            <div class="text-right">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Total Payable</span>
                <span class="text-xl font-black text-emerald-400">৳@amount.ToString("N0")</span>
            </div>
        </div>

        <div class="p-6 space-y-6">
            
            <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 text-xs space-y-1">
                <div class="flex justify-between">
                    <span class="text-slate-500">Merchant Reference:</span>
                    <span class="font-mono font-bold text-slate-800">@tranId</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Service Description:</span>
                    <span class="font-semibold text-slate-700">@purpose</span>
                </div>
            </div>

            <!-- Simulation Channels -->
            <div class="space-y-3">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                    Select Test Payment Channel to Simulate:
                </label>

                <!-- Success with bKash -->
                <form asp-action="Success" asp-controller="Payment" method="post" class="space-y-2">
                    <input type="hidden" name="tran_id" value="@tranId" />
                    <input type="hidden" name="val_id" value="MOCK-VAL-@tranId" />
                    <input type="hidden" name="amount" value="@amount" />
                    <input type="hidden" name="currency" value="BDT" />
                    <input type="hidden" name="card_type" value="BKASH-bKash Wallet" />
                    <input type="hidden" name="bank_tran_id" value="MOCK-BKASH-@Random.Shared.Next(100000, 999999)" />
                    
                    <button type="submit" class="w-full py-3.5 px-4 bg-[#e2136e] hover:bg-[#c90f61] text-white font-bold text-xs rounded-2xl shadow-sm transition flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-white text-[#e2136e] flex items-center justify-center text-[10px] font-black">bK</span>
                            <span>Simulate bKash Payment Success</span>
                        </span>
                        <span>৳@amount.ToString("N0") ➔</span>
                    </button>
                </form>

                <!-- Success with Nagad -->
                <form asp-action="Success" asp-controller="Payment" method="post">
                    <input type="hidden" name="tran_id" value="@tranId" />
                    <input type="hidden" name="val_id" value="MOCK-VAL-@tranId" />
                    <input type="hidden" name="amount" value="@amount" />
                    <input type="hidden" name="currency" value="BDT" />
                    <input type="hidden" name="card_type" value="NAGAD-Nagad Wallet" />
                    <input type="hidden" name="bank_tran_id" value="MOCK-NAGAD-@Random.Shared.Next(100000, 999999)" />
                    
                    <button type="submit" class="w-full py-3.5 px-4 bg-[#f7941d] hover:bg-[#e08316] text-white font-bold text-xs rounded-2xl shadow-sm transition flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-white text-[#f7941d] flex items-center justify-center text-[10px] font-black">ন</span>
                            <span>Simulate Nagad Payment Success</span>
                        </span>
                        <span>৳@amount.ToString("N0") ➔</span>
                    </button>
                </form>

                <!-- Success with Visa/Mastercard -->
                <form asp-action="Success" asp-controller="Payment" method="post">
                    <input type="hidden" name="tran_id" value="@tranId" />
                    <input type="hidden" name="val_id" value="MOCK-VAL-@tranId" />
                    <input type="hidden" name="amount" value="@amount" />
                    <input type="hidden" name="currency" value="BDT" />
                    <input type="hidden" name="card_type" value="VISA-Dutch Bangla Bank" />
                    <input type="hidden" name="bank_tran_id" value="MOCK-CARD-@Random.Shared.Next(100000, 999999)" />
                    
                    <button type="submit" class="w-full py-3.5 px-4 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-2xl shadow-sm transition flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <span>💳</span>
                            <span>Simulate Visa / Mastercard Payment Success</span>
                        </span>
                        <span>৳@amount.ToString("N0") ➔</span>
                    </button>
                </form>
            </div>

            <!-- Negative Testing -->
            <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
                <form asp-action="Fail" asp-controller="Payment" method="post" class="w-1/2">
                    <input type="hidden" name="tran_id" value="@tranId" />
                    <input type="hidden" name="failedreason" value="Simulated bank rejection / insufficient funds" />
                    <button type="submit" class="w-full py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-xl border border-rose-200 transition">
                        ✕ Simulate Failure
                    </button>
                </form>

                <form asp-action="Cancel" asp-controller="Payment" method="post" class="w-1/2">
                    <input type="hidden" name="tran_id" value="@tranId" />
                    <button type="submit" class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
                        Cancel Checkout
                    </button>
                </form>
            </div>

        </div>

    </div>

</div>
