@model List<Haven.Models.ProfessionalProfile>
@{
    ViewData["Title"] = "ভেরিফায়েড থেরাপিস্ট ডিরেক্টরি | Verified Therapist Directory";
    var selectedSpecialty = (string)(ViewBag.SelectedSpecialty ?? "All");
    var searchQuery = (string)(ViewBag.SearchQuery ?? "");
    var totalVerified = (int)(ViewBag.TotalVerified ?? Model.Count);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">

    <!-- Hero Header -->
    <div class="bg-gradient-to-r from-teal-950 via-slate-900 to-emerald-950 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-3xl relative z-10 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-xs font-extrabold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>BMDC & BCPS Verified Professional Directory</span>
            </div>
            
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
                ভেরিফায়েড প্রফেশনাল থেরাপিস্ট ডিরেক্টরি
            </h1>
            
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                বাংলাদেশ মেডিকেল অ্যান্ড ডেন্টাল কাউন্সিল (BMDC) ও ক্লিনিক্যাল সাইকোলজি স্বীকৃত সার্টিফাইড বিশেষজ্ঞগণ। সম্পূর্ণ গোপনীয়তা ও নিরাপত্তার সাথে মানসিক স্বাস্থ্য পরামর্শ এবং অ্যাপয়েন্টমেন্ট বুকিং করুন।
            </p>

            <div class="flex flex-wrap items-center justify-between gap-6 pt-4 border-t border-slate-800 mt-4">
                <div class="flex flex-wrap items-center gap-6 text-xs font-semibold text-teal-200">
                    <div class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold text-sm">✓</span>
                        <span>@totalVerified জন সার্টিফাইড ভেরিফায়েড বিশেষজ্ঞ সক্রিয়</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold text-sm">✓</span>
                        <span>১০০% গোপনীয় সেশন ও পরিচয়হীন অপশন</span>
                    </div>
                </div>

                <a asp-controller="Therapy" asp-action="Apply" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs rounded-xl shadow-md transition">
                    <span>👨‍⚕️ আপনি কি সার্টিফাইড থেরাপিস্ট? যুক্ত হন ➔</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
        <form method="get" asp-action="Directory" class="flex flex-col md:flex-row items-center justify-between gap-4">
            
            <!-- Search Input -->
            <div class="relative w-full md:w-96">
                <input type="text" name="search" value="@searchQuery" placeholder="থেরাপিস্টের নাম বা পদবি দিয়ে খুঁজুন..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-teal-600 focus:bg-white focus:outline-none transition" />
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>

            <!-- Specialty Chips -->
            <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-1 md:pb-0">
                <a asp-action="Directory" asp-route-specialty="All" asp-route-search="@searchQuery" class="px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap @(selectedSpecialty == "All" ? "bg-teal-700 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    সকল বিশেষজ্ঞ
                </a>
                <a asp-action="Directory" asp-route-specialty="Adolescent" asp-route-search="@searchQuery" class="px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap @(selectedSpecialty == "Adolescent" ? "bg-teal-700 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    কিশোর ট্রমা (Adolescent)
                </a>
                <a asp-action="Directory" asp-route-specialty="Depression" asp-route-search="@searchQuery" class="px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap @(selectedSpecialty == "Depression" ? "bg-teal-700 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    ডিপ্রেশন ও স্ট্রেস
                </a>
                <a asp-action="Directory" asp-route-specialty="Trauma" asp-route-search="@searchQuery" class="px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap @(selectedSpecialty == "Trauma" ? "bg-teal-700 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    ট্রমা ও সিবিটি
                </a>
                <a asp-action="Directory" asp-route-specialty="Addiction" asp-route-search="@searchQuery" class="px-3.5 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap @(selectedSpecialty == "Addiction" ? "bg-teal-700 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    আসক্তি নিরাময়
                </a>
            </div>

        </form>
    </div>

    <!-- Directory Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-slate-200 shadow-sm space-y-4">
            <div class="w-16 h-16 rounded-3xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-2xl">
                🔍
            </div>
            <h3 class="text-lg font-bold text-slate-800">কোনো ভেরিফায়েড থেরাপিস্ট পাওয়া যায়নি</h3>
            <p class="text-xs text-slate-500 max-w-md mx-auto">
                আপনার অনুসন্ধানের সাথে মিল রেখে কোনো বিশেষজ্ঞ পাওয়া যায়নি। অনুগ্রহ করে অন্য ফিল্টার চেষ্টা করুন।
            </p>
            <a asp-action="Directory" class="inline-flex px-4 py-2 bg-teal-700 text-white rounded-xl text-xs font-bold">
                সকল থেরাপিস্ট দেখুন
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var therapist in Model)
            {
                var therapistName = therapist.User?.FullName ?? "Dr. Specialist";
                var avatarUrl = therapist.User?.ProfilePictureUrl;

                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 p-6 flex flex-col justify-between group hover:border-teal-300">
                    
                    <div class="space-y-4">
                        
                        <!-- Profile Card Header: Photo & Name & Title -->
                        <div class="flex items-start gap-3.5">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="@therapistName" class="w-16 h-16 rounded-2xl object-cover border-2 border-teal-100 shadow-sm group-hover:scale-105 transition-transform" />
                            }
                            else
                            {
                                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-teal-800 to-teal-600 text-white flex items-center justify-center font-bold text-xl shadow-sm group-hover:scale-105 transition-transform">
                                    @(therapistName.Length > 0 ? therapistName.Substring(0, 1) : "T")
                                </div>
                            }

                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-bold text-slate-900 leading-tight truncate" title="@therapistName">
                                    @therapistName
                                </h3>
                                <p class="text-xs text-teal-800 font-semibold mt-0.5 truncate">
                                    @therapist.TitleEn
                                </p>
                                <p class="text-[11px] text-slate-500 truncate">
                                    @therapist.TitleBn
                                </p>
                            </div>
                        </div>

                        <!-- Verification Badge & BMDC Reg -->
                        <div class="flex items-center justify-between px-3 py-2 bg-emerald-50/90 border border-emerald-200/90 rounded-xl text-xs">
                            <div class="flex items-center gap-1.5 text-emerald-900 font-bold">
                                <span class="w-4 h-4 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[9px]">✓</span>
                                <span>BMDC Verified</span>
                            </div>
                            <span class="font-mono text-[11px] font-bold text-emerald-800">
                                @(string.IsNullOrEmpty(therapist.LicenseNo) ? "BMDC Verified" : therapist.LicenseNo)
                            </span>
                        </div>

                        <!-- Specialization & Experience & Rating -->
                        <div class="space-y-2 pt-1">
                            <div class="flex items-center justify-between text-xs text-slate-600">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-slate-400">🎯</span>
                                    <span class="font-bold text-slate-800">@therapist.Specialty</span>
                                </div>
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded-lg text-[10px] font-bold">
                                    @therapist.ExperienceYears+ Years Exp
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(therapist.HospitalAffiliation))
                            {
                                <div class="text-[11px] text-slate-500 flex items-center gap-1.5 truncate">
                                    <span>🏥</span>
                                    <span class="truncate">@therapist.HospitalAffiliation</span>
                                </div>
                            }

                            <!-- Rating & Reviews -->
                            <div class="flex items-center gap-2 text-xs font-semibold text-slate-600 pt-1">
                                <div class="flex items-center text-amber-500">
                                    <span>★</span>
                                    <span class="text-slate-900 ml-1 font-bold">@therapist.Rating.ToString("0.00")</span>
                                </div>
                                <span class="text-slate-300">•</span>
                                <span class="text-slate-500 text-[11px]">(@therapist.ReviewCount সেশন সম্পন্ন)</span>
                            </div>

                            <!-- Bio Snippet -->
                            @if (!string.IsNullOrEmpty(therapist.Bio))
                            {
                                <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 pt-1">
                                    @therapist.Bio
                                </p>
                            }
                        </div>

                    </div>

                    <!-- Card Footer: Fee & Booking CTA -->
                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                        <div>
                            <span class="text-[10px] text-slate-400 block font-semibold">পরামর্শ ফি (Session Fee)</span>
                            <span class="text-base font-black text-slate-900">৳@therapist.HourlyRateBDT</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <a asp-action="Profile" asp-route-id="@therapist.Id" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
                                প্রোফাইল
                            </a>
                            <button type="button" onclick="openBookingModal(@therapist.Id, '@therapistName', '@therapistName', @therapist.HourlyRateBDT)" class="px-3.5 py-2 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl transition shadow-sm hover:shadow-teal-900/20 active:scale-95 flex items-center gap-1">
                                <span>বুক করুন</span>
                                <span>➔</span>
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

<!-- Render Booking Modal Partial -->
<partial name="_TherapistBookingModal" model="new Haven.Models.BookingCreateModel()" />
