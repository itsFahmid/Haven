@model Haven.Models.ProfessionalProfile
@{
    var therapistName = Model.User?.FullName ?? "Dr. Specialist";
    var avatarUrl = Model.User?.ProfilePictureUrl;
    ViewData["Title"] = $"{therapistName} | Verified Therapist Profile";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a asp-action="Directory" class="hover:text-teal-700 transition">থেরাপিস্ট ডিরেক্টরি</a>
        <span>/</span>
        <span class="text-slate-800">@therapistName</span>
    </nav>

    <!-- Main Profile Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-teal-950 via-slate-900 to-teal-900 p-8 text-white relative">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                
                <div class="flex items-center gap-5">
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@therapistName" class="w-24 h-24 rounded-3xl object-cover border-4 border-white/20 shadow-lg" />
                    }
                    else
                    {
                        <div class="w-24 h-24 rounded-3xl bg-teal-700 text-white flex items-center justify-center font-black text-3xl border-4 border-white/20 shadow-lg">
                            @(therapistName.Length > 0 ? therapistName.Substring(0, 1) : "T")
                        </div>
                    }

                    <div class="space-y-1">
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-extrabold uppercase tracking-wider">
                            <span>✓ BMDC Verified Specialist</span>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-black text-white">@therapistName</h1>
                        <p class="text-xs sm:text-sm text-teal-200 font-medium">@Model.TitleEn</p>
                        <p class="text-xs text-slate-300">@Model.TitleBn</p>
                    </div>
                </div>

                <!-- Rate & CTA Button -->
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 text-right min-w-[180px]">
                    <span class="text-[11px] text-teal-200 uppercase font-semibold block">পরামর্শ ফি (১ ঘণ্টা)</span>
                    <span class="text-2xl font-black text-white">৳@Model.HourlyRateBDT</span>
                    <button type="button" onclick="openBookingModal(@Model.Id, '@therapistName', '@therapistName', @Model.HourlyRateBDT)" class="mt-3 w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs rounded-xl transition shadow-md flex items-center justify-center gap-1.5">
                        <span>সেশন বুক করুন</span>
                        <span>➔</span>
                    </button>
                </div>

            </div>
        </div>

        <!-- Details Grid -->
        <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <!-- Left Info Column -->
            <div class="md:col-span-2 space-y-6">
                
                <!-- About / Bio -->
                <div>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">
                        বিশেষজ্ঞ পরিচিতি (About Therapist)
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Bio) ? "মানসিক স্বাস্থ্য সহায়তা, কাউন্সেলিং এবং সাইকোথেরাপিতে অভিজ্ঞ ও নিবেদিত সার্টিফাইড বিশেষজ্ঞ।" : Model.Bio)
                    </p>
                </div>

                <!-- Specialty & Clinical Focus -->
                <div>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">
                        বিশেষ চিকিৎসা ক্ষেত্র (Specialization & Clinical Focus)
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-teal-50 text-teal-900 border border-teal-200">
                            🎯 @Model.Specialty
                        </span>
                        <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                            🛡️ কিশোর ও তরুণ কাউন্সেলিং
                        </span>
                        <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                            🔒 গোপনীয় অনলাইন সেশন
                        </span>
                    </div>
                </div>

                <!-- Qualifications -->
                @if (!string.IsNullOrEmpty(Model.Qualifications))
                {
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">
                            শিক্ষাগত যোগ্যতা ও সনদ (Qualifications)
                        </h3>
                        <p class="text-xs text-slate-600 bg-slate-50 p-4 rounded-2xl border border-slate-200 font-medium">
                            🎓 @Model.Qualifications
                        </p>
                    </div>
                }

                <!-- Confidentiality Pledge -->
                <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-emerald-900 text-xs space-y-1">
                    <div class="font-bold flex items-center gap-1.5">
                        <span>🛡️ হেভেন গোপনীয়তা অঙ্গীকার</span>
                    </div>
                    <p class="text-emerald-800 text-[11px] leading-relaxed">
                        আপনার প্রতিটি সেশন সম্পূর্ণভাবে এন্ড-টু-এন্ড এনক্রিপ্টেড এবং কোনো ব্যক্তিগত তথ্য তৃতীয় পক্ষের সাথে শেয়ার করা হয় না।
                    </p>
                </div>

            </div>

            <!-- Right Sidebar Meta -->
            <div class="space-y-4">
                
                <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200 space-y-4 text-xs">
                    <h4 class="font-bold text-slate-900 uppercase tracking-wider text-[11px] pb-2 border-b border-slate-200">
                        ভেরিফিকেশন ও তথ্য
                    </h4>

                    <div>
                        <span class="text-slate-400 block font-semibold">রেজিস্ট্রেশন নম্বর:</span>
                        <span class="font-mono font-bold text-slate-800">@Model.LicenseNo</span>
                    </div>

                    <div>
                        <span class="text-slate-400 block font-semibold">অভিজ্ঞতা:</span>
                        <span class="font-bold text-slate-800">@Model.ExperienceYears+ বছর</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.HospitalAffiliation))
                    {
                        <div>
                            <span class="text-slate-400 block font-semibold">কর্মস্থল / ইনস্টিটিউট:</span>
                            <span class="font-bold text-slate-800">@Model.HospitalAffiliation</span>
                        </div>
                    }

                    <div>
                        <span class="text-slate-400 block font-semibold">ভেরিফিকেশন স্থিতি:</span>
                        <span class="inline-flex items-center gap-1 text-emerald-700 font-bold">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            <span>অ্যাডমিন কর্তৃক অনুমোদিত (Approved)</span>
                        </span>
                    </div>
                </div>

                <!-- Direct Book Button -->
                <button type="button" onclick="openBookingModal(@Model.Id, '@therapistName', '@therapistName', @Model.HourlyRateBDT)" class="w-full py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-2xl transition shadow-lg shadow-teal-900/10 flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>অ্যাপয়েন্টমেন্ট বুকিং শুরু করুন</span>
                </button>

            </div>

        </div>

    </div>

</div>

<!-- Render Booking Modal Partial -->
<partial name="_TherapistBookingModal" model="new Haven.Models.BookingCreateModel()" />
